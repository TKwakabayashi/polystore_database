# Ignore database actual data
config/config.json
src/go/storage/config.go

# datastore/ のうち実データだけを無視する。
# compose.yaml / env / scripts は環境再現に必要なので追跡する。
# （env のパスワードは開発用ローカル固定値）
datastore/snapshots/
datastore/runtime/

# Ignore dump files
*.dump
.DS_Store
*.prof

#ignore meta folder
docs/
.vscode/
catalog/library

# Rust build artifacts
target/
# benchmark output
bench_results.csv
src/go/bench_results.csv
bench_results_wide.csv
src/go/bench_results_wide.csv

# generated outputs (bench CSV / pprof / trace / baseline) — kept local, not tracked
results/

# ANTLR generated artifacts
# .antlr/ は VS Code ANTLR 拡張のキャッシュ。output/ の .interp/.tokens はビルドに不要。
# output/*.go はビルドに必要なので追跡を続ける（再生成は /regen-parser）。
src/go/parser/.antlr/
src/go/parser/output/*.interp
src/go/parser/output/*.tokens
