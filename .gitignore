# The user's settings (template: config/config.example.json)
config/config.json

# Of datastore/, ignore data, instance state and machine-tuned env values; docker/compose.yaml,
# scripts/ and each dataset's mapping.json, stats.json and README.md are tracked to reproduce the
# environment. The per-environment env files are machine-dependent (heap sizes, published ports,
# volume names), so they are ignored and only their templates are tracked (*.env.example).
datastore/datasets/*/dumps/
datastore/runtime/
datastore/docker/.env
datastore/datasets/*/dataset.env
# the uuid lease ledger (template: datastore/shared/uuid_leases.example.json; also .lock / .tmp)
datastore/shared/uuid_leases.json*

*.dump
.DS_Store
*.prof

# local folders and immature local-only files
docs/
.vscode/
results/
.claude/
CLAUDE.md
analysis/

# Rust build artifacts
target/

# ANTLR generated artifacts
# .antlr/ is the VS Code ANTLR extension's cache; output/*.interp and *.tokens are not needed to build.
# output/*.go is needed to build and stays tracked (regenerate with /regen-parser).
src/go/query/cypher/parser/.antlr/
src/go/query/cypher/parser/output/*.interp
src/go/query/cypher/parser/output/*.tokens
