# Template for datastore/docker/.env (which is gitignored: machine-dependent).
# The default dataset when docker compose runs without --env-file. Naming the dataset's
# env file is safer: docker compose --env-file ../datasets/<dataset>/dataset.env up -d
# This is a minimal subset of ../datasets/<dataset>/dataset.env.
DATASET=ldbc_snb_sf1
VOLUMES=ldbc_sf1
NEO4J_IMAGE=neo4j:5
NEO4J_DATABASE=neo4j
# Host-published port for the container's Mongo (change if 27017 is free on your host).
MONGO_PORT=27018
