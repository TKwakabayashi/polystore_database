# Template for datastore/datasets/<dataset>/dataset.env (which is gitignored: machine-dependent).
# Copy to a dataset directory and adjust the machine-dependent values (heap/pagecache sized to
# your Docker VM, host-published ports, volume names).
# Load it with: docker compose --env-file ../datasets/<dataset>/dataset.env up -d

# Identity of the dataset and its docker volumes (any stable names).
DATASET=<dataset_name>
VOLUMES=<dataset_name>

# Neo4j (graph)
NEO4J_IMAGE=neo4j:5
NEO4J_DATABASE=neo4j
# Sized to the Docker VM's memory: heap + pagecache must stay under it.
NEO4J_HEAP_INITIAL=2G
NEO4J_HEAP_MAX=4G
NEO4J_PAGECACHE=1G
NEO4J_TX_TOTAL_MAX=4G

# Database / keyspace names the application expects (keep these values).
MYSQL_DATABASE=polystore_relational
CASSANDRA_KEYSPACE=polystore_widecolumn

# Host-published port for the container's Mongo (change if 27017 is free on your host).
MONGO_PORT=27018
