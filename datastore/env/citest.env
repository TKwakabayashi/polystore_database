# 合成 mini-SNB による結合テスト専用スタック（隔離環境）。
#
# 目的: 実データ（ldbc_sf1 等）のボリューム/ポートに一切触れずに、小さな合成データで
# engine 等価性・全ワークロード非空・migration ラウンドトリップを検証する。
#
# 起動（ポートは実スタックとずらしてあるが、メモリは別問題）:
#   cd datastore
#   docker compose --env-file env/citest.env up -d
#   docker compose --env-file env/citest.env --profile init run --rm cassandra-init
# 破棄:
#   docker compose --env-file env/citest.env down -v
#
# ⚠ メモリ注意: 実データスタック（ldbc_sf1 等・Neo4j 4G ヒープ）を起動したまま本スタックを
# 同時に立てると、Docker VM の物理メモリ（例 7.7G）を超えて実 Neo4j が OOM kill される
# （exit 137。データボリュームは無傷だが再起動が必要）。ローカルで同時に立てる場合は
# 実スタックを止めるか、Docker VM のメモリを増やすこと。CI（GitHub ランナー）では本スタック
# 単独で回るため問題ない。
DATASET=citest

# --- ポート（実スタックと衝突しないようずらす） ---
NEO4J_BOLT_PORT=17687
NEO4J_HTTP_PORT=17474
MONGO_PORT=27018
MYSQL_PORT=13306
CASSANDRA_PORT=19042

# --- Neo4j（小データなので省メモリ） ---
NEO4J_IMAGE=neo4j:5
NEO4J_DATABASE=neo4j
NEO4J_HEAP_INITIAL=512M
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=256M
NEO4J_TX_TOTAL_MAX=1G

# --- 他ストア ---
MYSQL_DATABASE=polystore_relational
CASSANDRA_KEYSPACE=polystore_columnar
CASSANDRA_HEAP=512M
CASSANDRA_HEAP_NEW=100M
