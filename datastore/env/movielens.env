# MovieLens
# dump: docker/snapshots/movielens/movielens.dump  -> DB 名は movielens
# Community(GPLv3)でロード・起動を確認済み
# （2026-07-16: User 162,541 / Movie 62,423）。
DATASET=movielens

NEO4J_IMAGE=neo4j:5
NEO4J_DATABASE=movielens
# 550MB dump と 3 データセット中で最小なので既定より控えめ。
NEO4J_HEAP_INITIAL=1G
NEO4J_HEAP_MAX=2G
NEO4J_PAGECACHE=1G
NEO4J_TX_TOTAL_MAX=2G

MYSQL_DATABASE=polystore_relational
CASSANDRA_KEYSPACE=polystore_columnar
