# LDBC SNB scale factor 1
# dump: docker/snapshots/ldbc_sf1/neo4j.dump  -> DB 名は neo4j
#
# 2026-07-16 に 2025-enterprise(block形式) から neo4j:5(Community) へ移行済み。
# 手順は migrate_ldbc_to_neo4j5.sh を参照（CSV 経由の論理コピー。ストアの
# ダウングレードは不可なため dump のロードでは移行できない）。
# 移行前の dump は neo4j.dump.neo4j2025.bak として同じディレクトリに退避してある
# （block 形式なので読むには neo4j:2025-enterprise が必要）。
#
# 移行後の検証: ノード 2,997,352 / リレーション 17,196,776 / 制約 16 で移行前と一致。
# creationDate は ZONED DATETIME、birthday は DATE、id は INTEGER を維持。
DATASET=ldbc_sf1

NEO4J_IMAGE=neo4j:5
NEO4J_DATABASE=neo4j
NEO4J_HEAP_INITIAL=2G
NEO4J_HEAP_MAX=4G
NEO4J_PAGECACHE=1G
NEO4J_TX_TOTAL_MAX=4G

MYSQL_DATABASE=polystore_relational
CASSANDRA_KEYSPACE=polystore_columnar
