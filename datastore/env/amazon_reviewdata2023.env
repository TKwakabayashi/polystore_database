# Amazon Review Data 2023
# dump: docker/snapshots/amazon_reviewdata2023/amazon.dump  -> DB 名は amazon
DATASET=amazon_reviewdata2023

# dump は neo4j:5 で生成したもの。Community(GPLv3)でロード・起動を確認済み
# （2026-07-16: User 23,235,852 / Item 3,735,584。ストア実体は約 33GB）。
NEO4J_IMAGE=neo4j:5
NEO4J_DATABASE=amazon
# heap+pagecache が Docker VM の物理メモリ(現状 7.7G)を超えると Neo4j は起動を拒否する。
# Docker Desktop のメモリ割当を増やしたらここも上げてよい。
NEO4J_HEAP_INITIAL=2G
NEO4J_HEAP_MAX=4G
NEO4J_PAGECACHE=1G
NEO4J_TX_TOTAL_MAX=4G

MYSQL_DATABASE=polystore_relational
CASSANDRA_KEYSPACE=polystore_columnar
