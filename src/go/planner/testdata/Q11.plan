Return[friend.id, friend.firstName, friend.lastName, comp.name, work.workFrom]
  Limit[10]
    Sort[work.workFrom ASC, friend.id ASC, comp.name DESC]
      Projection(input:comp,friend,work, slot:map[comp:0 friend:1 work:2]) [Materialize: comp(graph[name]) | friend(graph[id firstName lastName]) | work(graph[workFrom])]
        Filter(input:Nalias_0,comp,friend,work, slot:map[Nalias_0:0 comp:1 friend:2 work:3]) (output:comp,friend,work, slot:map[comp:0 friend:1 work:2]) [Store: graph, Alias: Nalias_0, Label: Place, Condition: {(Nalias_0.type = Country AND Nalias_0.name = Germany)}]
          Expand(input:comp,friend,work, slot:map[comp:0 friend:1 work:2]) (output:Nalias_0,comp,friend,work, slot:map[Nalias_0:0 comp:1 friend:2 work:3]) [(comp)-[Ealias_1:IS_LOCATED_IN]->(Nalias_0:Place)]
            Filter(input:comp,friend,work, slot:map[comp:0 friend:1 work:2]) (output:comp,friend,work, slot:map[comp:0 friend:1 work:2]) [Store: graph, Alias: comp, Label: Organisation, Condition: {comp.type = Company}]
              Filter(input:comp,friend,work, slot:map[comp:0 friend:1 work:2]) (output:comp,friend,work, slot:map[comp:0 friend:1 work:2]) [Store: graph, Alias: work, Label: WORK_AT, Condition: {work.workFrom < 2008}]
                Expand(input:friend, slot:map[friend:0]) (output:comp,friend,work, slot:map[comp:0 friend:1 work:2]) [(friend)-[work:WORK_AT]->(comp:Organisation)]
                  VarLengthExpand(input:p, slot:map[p:0]) (output:friend, slot:map[friend:0]) [(p)-[Ealias_0:KNOWS*1..3]-(friend:Person), Condition:{}]
                    EntityScan(output:p, slot:map[p:0]) [Alias: p, Label: Person, Store: graph, Condition: {p.id = 15393162799448}]
