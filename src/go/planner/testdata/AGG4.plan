Return[m.id, m.length]
  Limit[20]
    Sort[m.length DESC, m.id ASC]
      Projection(input:m, slot:map[m:0]) [Materialize: m(graph[id length])]
        Filter(input:m, slot:map[m:0]) (output:m, slot:map[m:0]) [Store: graph, Alias: m, Label: Message, Condition: {(m.length >= 50 AND m.length <= 200)}]
          Expand(input:p, slot:map[p:0]) (output:m, slot:map[m:0]) [(p)<-[Ealias_0:HAS_CREATOR]-(m:Message)]
            EntityScan(output:p, slot:map[p:0]) [Alias: p, Label: Person, Store: graph, Condition: {p.id = 15393162799448}]
