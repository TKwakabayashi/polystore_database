### chain_with_filter
MATCH (p:Person {id: $x})-[:KNOWS]->(f:Person) WHERE f.gender = 'male' RETURN f.firstName, f.id
Projection[f.firstName, f.id]
  GetProperty(f.id) [node:Person]
    GetProperty(f.firstName) [node:Person]
      Filter((f.gender = "male"))
        GetProperty(f.gender) [node:Person]
          Expand((p)-[_r0:KNOWS]->(f:Person))
            Filter((p.id = 1))
              GetProperty(p.id) [node:Person]
                EntityScan(p:Person)

### cycle
MATCH (a:Person {id: $x})-[:KNOWS]->(b)-[:KNOWS]->(c)-[:KNOWS]->(a) RETURN b.id, c.id
Projection[b.id, c.id]
  GetProperty(c.id) [node]
    GetProperty(b.id) [node]
      RelUniqueFilter[_r0, _r1, _r2]
        ExpandInto((c)-[_r2:KNOWS]->(a))
          Expand((b)-[_r1:KNOWS]->(c))
            Expand((a)-[_r0:KNOWS]->(b))
              Filter((a.id = 1))
                GetProperty(a.id) [node:Person]
                  EntityScan(a:Person)

### reverse_connection
MATCH (a:Person {id: $x}), (b:Person)-[:KNOWS]->(a) RETURN b.id
Projection[b.id]
  GetProperty(b.id) [node:Person]
    Expand((a)<-[_r0:KNOWS]-(b:Person))
      Filter((a.id = 1))
        GetProperty(a.id) [node:Person]
          EntityScan(a:Person)

### cartesian
MATCH (a:Person {id: $x}), (t:Tag {name: 'x'}) RETURN a.id, t.id
Projection[a.id, t.id]
  GetProperty(t.id) [node:Tag]
    NodeHashJoin[cartesian]
      Filter((a.id = 1))
        GetProperty(a.id) [node:Person]
          EntityScan(a:Person)
      Filter((t.name = "x"))
        GetProperty(t.name) [node:Tag]
          EntityScan(t:Tag)

### cross_alias_predicate
MATCH (a:Person)-[:KNOWS]-(b:Person) WHERE a.id < b.id RETURN a.id, b.id
Projection[a.id, b.id]
  Filter((a.id < b.id))
    GetProperty(b.id) [node:Person]
      GetProperty(a.id) [node:Person]
        Expand((a)-[_r0:KNOWS]-(b:Person))
          EntityScan(a:Person)

### start_choice
MATCH (a:Person)-[:KNOWS]->(b:Person {id: $x}) RETURN a.id
Projection[a.id]
  GetProperty(a.id) [node:Person]
    Expand((b)<-[_r0:KNOWS]-(a:Person))
      Filter((b.id = 1))
        GetProperty(b.id) [node:Person]
          EntityScan(b:Person)

### with_aggregate
MATCH (p:Person)-[:KNOWS]->(f:Person) WITH p, count(f) AS deg WHERE deg > 10 MATCH (p)-[:IS_LOCATED_IN]->(c:Place) RETURN p.id, deg, c.name ORDER BY deg DESC LIMIT 3
Limit[3]
  Sort[deg DESC]
    Projection[p.id, deg, c.name]
      GetProperty(c.name) [node:Place]
        GetProperty(p.id) [node:Person]
          Expand((p)-[_r1:IS_LOCATED_IN]->(c:Place))
            Filter((deg > 10))
              Aggregation[keys: p | count(f) AS deg]
                Expand((p)-[_r0:KNOWS]->(f:Person))
                  EntityScan(p:Person)

### with_distinct_order_limit
MATCH (p:Person {id: $x})-[:KNOWS]-(f:Person) WITH DISTINCT f ORDER BY f.id ASC LIMIT 3 MATCH (f)-[:KNOWS]-(g:Person) RETURN g.id
Projection[g.id]
  GetProperty(g.id) [node:Person]
    Expand((f)-[_r1:KNOWS]-(g:Person))
      Projection[f]
        Limit[3]
          Sort[f.id ASC]
            GetProperty(f.id) [node:Person]
              Distinct
                Projection[f]
                  Expand((p)-[_r0:KNOWS]-(f:Person))
                    Filter((p.id = 1))
                      GetProperty(p.id) [node:Person]
                        EntityScan(p:Person)

### with_rename
MATCH (p:Person {id: $x})-[:KNOWS]-(f:Person) WITH f AS friend RETURN friend.id
Projection[friend.id]
  GetProperty(friend.id) [node:Person]
    Projection[f AS friend]
      Expand((p)-[_r0:KNOWS]-(f:Person))
        Filter((p.id = 1))
          GetProperty(p.id) [node:Person]
            EntityScan(p:Person)

### order_by_hidden
MATCH (p:Person) RETURN p.firstName ORDER BY p.id DESC LIMIT 10
Projection[p.firstName]
  Limit[10]
    Sort[_sort0 DESC]
      Projection[p.firstName, p.id AS _sort0]
        GetProperty(p.id) [node:Person]
          GetProperty(p.firstName) [node:Person]
            EntityScan(p:Person)

### case_expr
MATCH (p:Person {id: $x}) RETURN p.id, CASE WHEN p.gender = 'male' THEN 1 ELSE 0 END AS isMale
Projection[p.id, CASE WHEN (p.gender = "male") THEN 1 ELSE 0 END AS isMale]
  GetProperty(p.gender) [node:Person]
    Filter((p.id = 1))
      GetProperty(p.id) [node:Person]
        EntityScan(p:Person)

### path_length_absorbed
MATCH p=(a:Person {id: $x})-[:KNOWS]->(b:Person)-[:KNOWS*1..3]-(c:Person) WHERE length(p) <= 3 RETURN c.id
Projection[c.id]
  GetProperty(c.id) [node:Person]
    RelUniqueFilter[_r0, _seg__r1]
      VarLengthExpand((b)-[_r1:KNOWS*1..2]-(c:Person))
        Expand((a)-[_r0:KNOWS]->(b:Person))
          Filter((a.id = 1))
            GetProperty(a.id) [node:Person]
              EntityScan(a:Person)

### path_all_nodes
MATCH p=(a:Person {id: $x})-[:KNOWS]->(b:Person)-[:KNOWS*1..3]-(c:Person) WHERE all(n IN nodes(p) WHERE n.gender = 'male') RETURN c.id
Projection[c.id]
  GetProperty(c.id) [node:Person]
    RelUniqueFilter[_r0, _seg__r1]
      Filter((c.gender = "male"))
        GetProperty(c.gender) [node:Person]
          VarLengthExpand((b)-[_r1:KNOWS*1..3]-(c:Person)) seg[all(n IN nodes WHERE (n.gender = "male"))]
            Filter((b.gender = "male"))
              GetProperty(b.gender) [node:Person]
                Expand((a)-[_r0:KNOWS]->(b:Person))
                  Filter((a.id = 1))
                    GetProperty(a.id) [node:Person]
                      Filter((a.gender = "male"))
                        GetProperty(a.gender) [node:Person]
                          EntityScan(a:Person)

### path_none_rels
MATCH p=(a:Person {id: $x})-[r:KNOWS]->(b:Person)-[:KNOWS*1..2]-(c:Person) WHERE none(e IN relationships(p) WHERE e.creationDate < 2010) RETURN c.id
Projection[c.id]
  GetProperty(c.id) [node:Person]
    RelUniqueFilter[r, _seg__r0]
      VarLengthExpand((b)-[_r0:KNOWS*1..2]-(c:Person)) seg[all(e IN rels WHERE NOT((e.creationDate < 2010)))]
        Filter(NOT((r.creationDate < 2010)))
          GetProperty(r.creationDate) [rel:KNOWS]
            Expand((a)-[r:KNOWS]->(b:Person))
              Filter((a.id = 1))
                GetProperty(a.id) [node:Person]
                  EntityScan(a:Person)

### path_any_kept
MATCH p=(a:Person {id: $x})-[:KNOWS*1..2]-(c:Person) WHERE any(n IN nodes(p) WHERE n.gender = 'female') RETURN c.id
Projection[c.id]
  GetProperty(c.id) [node:Person]
    Filter(any(n IN nodes(p) WHERE (n.gender = "female")))
      GetListProperty(p.nodes.gender) [elem]
        ProjectPath(p = [a, _seg__r0, c])
          VarLengthExpand((a)-[_r0:KNOWS*1..2]-(c:Person))
            Filter((a.id = 1))
              GetProperty(a.id) [node:Person]
                EntityScan(a:Person)

### path_length_fixed_only
MATCH p=(a:Person {id: $x})-[:KNOWS]->(b:Person) WHERE length(p) > 2 RETURN b.id
Projection[b.id]
  GetProperty(b.id) [node:Person]
    Expand((a)-[_r0:KNOWS]->(b:Person))
      Filter((a.id = 1))
        GetProperty(a.id) [node:Person]
          Filter(false)
            EntityScan(a:Person)

### rel_uniqueness
MATCH (a:Person {id: $x})-[:KNOWS]-(b:Person)-[:KNOWS]-(c:Person) RETURN c.id
Projection[c.id]
  GetProperty(c.id) [node:Person]
    RelUniqueFilter[_r0, _r1]
      Expand((b)-[_r1:KNOWS]-(c:Person))
        Expand((a)-[_r0:KNOWS]-(b:Person))
          Filter((a.id = 1))
            GetProperty(a.id) [node:Person]
              EntityScan(a:Person)

