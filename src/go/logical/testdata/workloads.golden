            Expand((f)-[_r2:HAS_MODERATOR]->(mod:Person))
              Expand((_n0)<-[_r1:CONTAINER_OF]-(f:Forum))
                VarLengthExpand((m)-[_r0:REPLY_OF*0..]->(_n0:Post))
                  Filter((m.id = 1030792151051))
                    GetProperty(m.id) [node:Message]
                      EntityScan(m:Message)

### IS7
Sort[commentCreationDate DESC, replyAuthorId ASC]
  Projection[c.id AS commentId, c.content AS commentContent, c.creationDate AS commentCreationDate, p.id AS replyAuthorId, p.firstName AS replyAuthorFirstName, p.lastName AS replyAuthorLastName, CASE WHEN (r = null) THEN false ELSE true END AS replyAuthorKnowsOriginalMessageAuthor]
    GetProperty(p.lastName) [node:Person]
      GetProperty(p.firstName) [node:Person]
        GetProperty(p.id) [node:Person]
          GetProperty(c.creationDate) [node:Comment]
            GetProperty(c.content) [node:Comment]
              GetProperty(c.id) [node:Comment]
                Optional[keys: m, p | new: _r2, a, r]
                  Expand((c)-[_r1:HAS_CREATOR]->(p:Person))
                    Expand((m)<-[_r0:REPLY_OF]-(c:Comment))
                      Filter((m.id = 1030792151051))
                        GetProperty(m.id) [node:Message]
                          EntityScan(m:Message)
                  ExpandInto((a)-[r:KNOWS]-(p))
                    Expand((m)-[_r2:HAS_CREATOR]->(a:Person))
                      Argument(m, p)

