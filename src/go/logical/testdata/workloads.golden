### AGG1
Limit[20]
  Sort[replyCount DESC, author.id ASC]
    Aggregation[keys: author.id, author.firstName, author.lastName | count(comment) AS replyCount]
      GetProperty(author.lastName) [node:Person]
        GetProperty(author.firstName) [node:Person]
          GetProperty(author.id) [node:Person]
            RelUniqueFilter[_r0, _r2]
              Expand((comment)-[_r2:HAS_CREATOR]->(author:Person))
                Expand((m)<-[_r1:REPLY_OF]-(comment:Comment))
                  Expand((p)<-[_r0:HAS_CREATOR]-(m:Message))
                    Filter((p.id = 15393162799448))
                      GetProperty(p.id) [node:Person]
                        EntityScan(p:Person)

### AGG2
Limit[20]
  Sort[msgCount DESC, friend.id ASC]
    Aggregation[keys: friend.id, friend.firstName | count(m) AS msgCount, avg(m.length) AS avgLen, max(m.length) AS maxLen]
      GetProperty(m.length) [node:Message]
        GetProperty(friend.firstName) [node:Person]
          GetProperty(friend.id) [node:Person]
            Expand((friend)<-[_r1:HAS_CREATOR]-(m:Message))
              Expand((p)-[_r0:KNOWS]-(friend:Person))
                Filter((p.id = 15393162799448))
                  GetProperty(p.id) [node:Person]
                    EntityScan(p:Person)

### AGG3
Aggregation[keys: ∅ | count(*) AS total, count(DISTINCT friend.id) AS friends, sum(m.length) AS totLen, avg(m.length) AS avgLen, min(m.length) AS minLen, max(m.length) AS maxLen]
  GetProperty(m.length) [node:Message]
    GetProperty(friend.id) [node:Person]
      Expand((friend)<-[_r1:HAS_CREATOR]-(m:Message))
        Expand((p)-[_r0:KNOWS]-(friend:Person))
          Filter((p.id = 15393162799448))
            GetProperty(p.id) [node:Person]
              EntityScan(p:Person)

### AGG4
Limit[20]
  Sort[m.length DESC, m.id ASC]
    Projection[m.id, m.length]
      GetProperty(m.id) [node:Message]
        Filter((m.length <= 200))
          Filter((m.length >= 50))
            GetProperty(m.length) [node:Message]
              Expand((p)<-[_r0:HAS_CREATOR]-(m:Message))
                Filter((p.id = 15393162799448))
                  GetProperty(p.id) [node:Person]
                    EntityScan(p:Person)

### AGG5
Aggregation[keys: ∅ | count(*) AS cnt, min(o.id) AS mn, max(o.id) AS mx, sum(o.id) AS sm, avg(o.id) AS av]
  Filter((o.id <= 5000))
    Filter((o.id >= 100))
      GetProperty(o.id) [node:Organisation]
        EntityScan(o:Organisation)

### AGG6
Sort[cnt DESC]
  Aggregation[keys: o.type | count(*) AS cnt, min(o.id) AS mn, max(o.id) AS mx]
    GetProperty(o.id) [node:Organisation]
      GetProperty(o.type) [node:Organisation]
        EntityScan(o:Organisation)

### BI12
Sort[personCount DESC, messageCount DESC]
  Aggregation[keys: messageCount | count(person) AS personCount]
    Aggregation[keys: person | count(message) AS messageCount]
      Optional[keys: person | new: _r0, message, _r1, post]
        EntityScan(person:Person)
        Filter((post.language IN ["ar", "hu"]))
          GetProperty(post.language) [node:Post]
            VarLengthExpand((message)-[_r1:REPLY_OF*0..]->(post:Post))
              Filter((message.creationDate > "2010-07-22T00:00:00.000Z"))
                GetProperty(message.creationDate) [node:Message]
                  Filter((message.length < 20))
                    GetProperty(message.length) [node:Message]
                      Filter((message.content IS NOT NULL))
                        GetProperty(message.content) [node:Message]
                          Expand((person)<-[_r0:HAS_CREATOR]-(message:Message))
                            Argument(person)

### BI3
Limit[20]
  Sort[messageCount DESC, forum.id ASC]
    Aggregation[keys: forum.id, forum.title, forum.creationDate, person.id | count(DISTINCT message.id) AS messageCount]
      GetProperty(message.id) [node:Message]
        GetProperty(person.id) [node:Person]
          GetProperty(forum.creationDate) [node:Forum]
            GetProperty(forum.title) [node:Forum]
              GetProperty(forum.id) [node:Forum]
                Filter((tagclass.name = "MusicalArtist"))
                  GetProperty(tagclass.name) [node:TagClass]
                    Expand((tag)-[_r6:HAS_TYPE]->(tagclass:TagClass))
                      Expand((message)-[_r5:HAS_TAG]->(tag:Tag))
                        VarLengthExpand((post)<-[_r4:REPLY_OF*0..]-(message:Message))
                          Expand((forum)-[_r3:CONTAINER_OF]->(post:Post))
                            Expand((person)<-[_r2:HAS_MODERATOR]-(forum:Forum))
                              Expand((city)<-[_r1:IS_LOCATED_IN]-(person:Person))
                                Expand((country)<-[_r0:IS_PART_OF]-(city:Place))
                                  Filter((country.name = "Germany"))
                                    GetProperty(country.name) [node:Place]
                                      Filter((country.type = "Country"))
                                        GetProperty(country.type) [node:Place]
                                          EntityScan(country:Place)

### BI5
Limit[100]
  Sort[score DESC, person.id ASC]
    Projection[person.id, replyCount, likeCount, messageCount, (((1 * messageCount) + (2 * replyCount)) + (10 * likeCount)) AS score]
      GetProperty(person.id) [node:Person]
        Aggregation[keys: person | count(message) AS messageCount, sum(likeCount) AS likeCount, sum(replyCount) AS replyCount]
          Aggregation[keys: person, message, likeCount | count(reply) AS replyCount]
            Optional[keys: message | new: _r2, reply]
              Aggregation[keys: person, message | count(likes) AS likeCount]
                Optional[keys: message | new: likes, _n0]
                  Expand((message)-[_r1:HAS_CREATOR]->(person:Person))
                    Expand((tag)<-[_r0:HAS_TAG]-(message:Message))
                      Filter((tag.name = "Abbas_I_of_Persia"))
                        GetProperty(tag.name) [node:Tag]
                          EntityScan(tag:Tag)
                  Expand((message)<-[likes:LIKES]-(_n0:Person))
                    Argument(message)
              Expand((message)<-[_r2:REPLY_OF]-(reply:Comment))
                Argument(message)

### BI6
Limit[100]
  Sort[authorityScore DESC, person1.id ASC]
    Aggregation[keys: person1.id | count(DISTINCT like) AS authorityScore]
      GetProperty(person1.id) [node:Person]
        Optional[keys: person2 | new: _r3, message2, like, person3]
          Optional[keys: message1 | new: _r2, person2]
            Expand((message1)-[_r1:HAS_CREATOR]->(person1:Person))
              Expand((tag)<-[_r0:HAS_TAG]-(message1:Message))
                Filter((tag.name = "Arnold_Schwarzenegger"))
                  GetProperty(tag.name) [node:Tag]
                    EntityScan(tag:Tag)
            Expand((message1)<-[_r2:LIKES]-(person2:Person))
              Argument(message1)
          Expand((message2)<-[like:LIKES]-(person3:Person))
            Expand((person2)<-[_r3:HAS_CREATOR]-(message2:Message))
              Argument(person2)

### BI9
Limit[100]
  Sort[messageCount DESC, person.id ASC]
    Aggregation[keys: person.id, person.firstName, person.lastName | count(DISTINCT post.id) AS threadCount, count(DISTINCT reply.id) AS messageCount]
      GetProperty(reply.id) [node:Message]
        GetProperty(post.id) [node:Post]
          GetProperty(person.lastName) [node:Person]
            GetProperty(person.firstName) [node:Person]
              GetProperty(person.id) [node:Person]
                Filter((reply.creationDate <= "2013-01-01T00:00:00.000Z"))
                  Filter((reply.creationDate >= "2010-01-01T00:00:00.000Z"))
                    GetProperty(reply.creationDate) [node:Message]
                      VarLengthExpand((post)<-[_r1:REPLY_OF*0..]-(reply:Message))
                        Expand((post)-[_r0:HAS_CREATOR]->(person:Person))
                          Filter((post.creationDate <= "2013-01-01T00:00:00.000Z"))
                            Filter((post.creationDate >= "2010-01-01T00:00:00.000Z"))
                              GetProperty(post.creationDate) [node:Post]
                                EntityScan(post:Post)

### INLIST
Limit[20]
  Sort[o.id ASC]
    Projection[o.id, o.type]
      GetProperty(o.id) [node:Organisation]
        Filter((o.type IN ["Company", "University"]))
          GetProperty(o.type) [node:Organisation]
            EntityScan(o:Organisation)

### IS1
Projection[p.firstName, p.lastName, p.birthday, p.locationIP, p.browserUsed, c.id, p.gender, p.creationDate]
  GetProperty(p.creationDate) [node:Person]
    GetProperty(p.gender) [node:Person]
      GetProperty(c.id) [node:City]
        GetProperty(p.browserUsed) [node:Person]
          GetProperty(p.locationIP) [node:Person]
            GetProperty(p.birthday) [node:Person]
              GetProperty(p.lastName) [node:Person]
                GetProperty(p.firstName) [node:Person]
                  Expand((p)-[_r0:IS_LOCATED_IN]->(c:City))
                    Filter((p.id = 21990232558284))
                      GetProperty(p.id) [node:Person]
                        EntityScan(p:Person)

