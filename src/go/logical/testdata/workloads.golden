### Q11
Limit[10]
  Sort[work.workFrom ASC, friend.id ASC, comp.name DESC]
    Projection[friend.id, friend.firstName, friend.lastName, comp.name, work.workFrom]
      GetProperty(comp.name) [node:Organisation]
        GetProperty(friend.lastName) [node:Person]
          GetProperty(friend.firstName) [node:Person]
            GetProperty(friend.id) [node:Person]
              Filter((_n0.name = "Germany"))
                GetProperty(_n0.name) [node:Place]
                  Filter((_n0.type = "Country"))
                    GetProperty(_n0.type) [node:Place]
                      Expand((comp)-[_r1:IS_LOCATED_IN]->(_n0:Place))
                        Filter((comp.type = "Company"))
                          GetProperty(comp.type) [node:Organisation]
                            Filter((work.workFrom < 2008))
                              GetProperty(work.workFrom) [rel:WORK_AT]
                                Expand((friend)-[work:WORK_AT]->(comp:Organisation))
                                  VarLengthExpand((p)-[_r0:KNOWS*1..3]-(friend:Person))
                                    Filter((p.id = 15393162799448))
                                      GetProperty(p.id) [node:Person]
                                        EntityScan(p:Person)

