### BI3 @graph
[neo4j] columns=(forum.id, forum.title, forum.creationDate, person.id, messageCount)
  MATCH (_n0:Country) WHERE (_n0.name = $p0) MATCH (_n0)<-[_r0:IS_PART_OF]-(_n1:City) MATCH (_n1)<-[_r1:IS_LOCATED_IN]-(person:Person) MATCH (person)<-[_r2:HAS_MODERATOR]-(forum:Forum) MATCH (forum)-[_r3:CONTAINER_OF]->(post:Post) MATCH _sp_r4 = (post)<-[:REPLY_OF*0..]-(message:Message) MATCH (message)-[_r5:HAS_TAG]->(_n2:Tag) MATCH (_n2)-[_r6:HAS_TYPE]->(_n3:TagClass) WHERE (_n3.name = $p1) WITH forum.id AS v0, forum.title AS v1, forum.creationDate AS v2, person.id AS v3, count(DISTINCT message) AS v4 RETURN v0 AS c0, v1 AS c1, v2 AS c2, v3 AS c3, v4 AS c4 ORDER BY v4 DESC, v0 LIMIT 20
  params: p0="Germany", p1="MusicalArtist"

