### BI9 @graph
[neo4j] columns=(person.id, person.firstName, person.lastName, threadCount, messageCount)
  MATCH (post:Post) WHERE (post.creationDate >= $p0) AND (post.creationDate <= $p1) MATCH (post)-[_r0:HAS_CREATOR]->(person:Person) MATCH _sp_r1 = (post)<-[:REPLY_OF*0..]-(reply:Message) WHERE (reply.creationDate >= $p2) AND (reply.creationDate <= $p3) WITH person.id AS v0, person.firstName AS v1, person.lastName AS v2, count(DISTINCT post) AS v3, count(DISTINCT reply) AS v4 RETURN v0 AS c0, v1 AS c1, v2 AS c2, v3 AS c3, v4 AS c4 ORDER BY v4 DESC, v0 LIMIT 100
  params: p0=2010-01-01 00:00:00 +0000 UTC(time.Time), p1=2013-01-01 00:00:00 +0000 UTC(time.Time), p2=2010-01-01 00:00:00 +0000 UTC(time.Time), p3=2013-01-01 00:00:00 +0000 UTC(time.Time)

