### binary uuid @relational
MATCH (p:Person {id: $x})-[:KNOWS]-(f:Person)<-[:HAS_CREATOR]-(m:Message) RETURN f.firstName, count(*) AS n, avg(m.length) AS a
[neo4j] columns=(f, m)
  MATCH (p:Person) WHERE (p.id = $p0) MATCH (p)-[_r0:KNOWS]-(f:Person) MATCH (f)<-[_r1:HAS_CREATOR]-(m:Message) RETURN f.uuid AS c0, m.uuid AS c1
  params: p0=1(int64)
[mysql] columns=(f, _p1_0, _p1_1s, _p1_1c) in=(m) shipped=aggregate table=(k0, s0, w)
  SELECT UNHEX(t.`s0`) AS c0, SUM(t.`w`) AS c1, SUM(t.`w` * d.`length`) AS c2, SUM(CASE WHEN d.`length` IS NULL THEN 0 ELSE t.`w` END) AS c3 FROM JSON_TABLE(CAST(? AS JSON), '$[*]' COLUMNS(`k0` VARCHAR(32) COLLATE utf8mb4_bin PATH '$[0]', `s0` VARCHAR(32) COLLATE utf8mb4_bin PATH '$[1]', `w` BIGINT PATH '$[2]')) AS t LEFT JOIN `Message` AS d ON d.`uuid` = UNHEX(t.`k0`) GROUP BY UNHEX(t.`s0`)
  args: <in>
[neo4j] columns=(f, f.firstName) in=(f)
  MATCH (f:Person) WHERE f.uuid IN $in RETURN f.uuid AS c0, f.firstName AS c1
[coordinator] Aggregation[keys: f.firstName | sum(_p1_0) AS n, sum(_p1_1s) AS _p1_1s, sum(_p1_1c) AS _p1_1c]
[coordinator] Projection[f.firstName, n, CASE WHEN (_p1_1c = 0) THEN null ELSE (tofloat(_p1_1s) / _p1_1c) END AS a]

### mode=filter @mysql
[mysql] columns=(_rid) in=(m) shipped=filter table=(rid, k0, s0)
  SELECT t.`rid` AS c0 FROM JSON_TABLE(CAST(? AS JSON), '$[*]' COLUMNS(`rid` BIGINT PATH '$[0]', `k0` VARCHAR(36) COLLATE utf8mb4_bin PATH '$[1]', `s0` VARCHAR(36) COLLATE utf8mb4_bin PATH '$[2]')) AS t LEFT JOIN `Message` AS d ON d.`uuid` = t.`k0` WHERE (d.`length` > ?)
  args: <in>, 10(int64)

### mode=filter @mongo
[mongo] columns=(_rid) in=(m) shipped=filter table=(rid, k0, s0)
  db.aggregate([
    {$documents: {rows: <in>}}
    {$lookup: {from: "Message", localField: "k0", foreignField: "uuid", as: "d"}}
    {$unwind: {path: "$d", preserveNullAndEmptyArrays: true(bool)}}
    {$match: {d.length: {$gt: 10(int64)}}}
    {$project: {_id: 0(int), c0: "$rid"}}
  ])

### mode=project @mysql
[mysql] columns=(_rid, m.length) in=(m) shipped=project table=(rid, k0, s0)
  SELECT t.`rid` AS c0, d.`length` AS c1 FROM JSON_TABLE(CAST(? AS JSON), '$[*]' COLUMNS(`rid` BIGINT PATH '$[0]', `k0` VARCHAR(36) COLLATE utf8mb4_bin PATH '$[1]', `s0` VARCHAR(36) COLLATE utf8mb4_bin PATH '$[2]')) AS t LEFT JOIN `Message` AS d ON d.`uuid` = t.`k0` WHERE (d.`length` > ?)
  args: <in>, 10(int64)

### mode=project @mongo
[mongo] columns=(_rid, m.length) in=(m) shipped=project table=(rid, k0, s0)
  db.aggregate([
    {$documents: {rows: <in>}}
    {$lookup: {from: "Message", localField: "k0", foreignField: "uuid", as: "d"}}
    {$unwind: {path: "$d", preserveNullAndEmptyArrays: true(bool)}}
    {$match: {d.length: {$gt: 10(int64)}}}
    {$project: {_id: 0(int), c0: "$rid", c1: "$d.length"}}
  ])

