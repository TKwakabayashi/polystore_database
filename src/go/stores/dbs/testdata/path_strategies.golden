### all_nodes @prefilter
MATCH p=(a:Person {id: $x})-[:KNOWS*1..3]-(c:Person) WHERE all(n IN nodes(p) WHERE n.gender = 'male') RETURN c.id
[mongo] columns=(_set0)
  db.Person.aggregate([
    {$match: {gender: {$eq: "male"}}}
    {$project: {_id: 0(int), v0: "$uuid", uuid: 1(int), v1: "$gender"}}
    {$project: {_id: 0(int), c0: "$uuid"}}
  ])
[mongo] columns=(a)
  db.Person.aggregate([
    {$match: {gender: {$eq: "male"}}}
    {$project: {_id: 0(int), c0: "$uuid"}}
  ])
[neo4j] columns=(a, c, _w) in=(a)
  MATCH (a:Person) WHERE a.uuid IN $in AND (a.id = $p0) MATCH _sp_r0 = (a)-[:KNOWS*1..3]-(c:Person) WHERE all(n IN nodes(_sp_r0)[1..-1] WHERE (n.uuid IN $p1)) RETURN a.uuid AS c0, c.uuid AS c1, count(*) AS c2
  params: p0=1(int64), p1=[]([]string)
[mongo] columns=(c) in=(c)
  db.Person.aggregate([
    {$match: {uuid: {$in: <in>}, gender: {$eq: "male"}}}
    {$project: {_id: 0(int), c0: "$uuid"}}
  ])
[neo4j] columns=(c, c.id) in=(c)
  MATCH (c:Person) WHERE c.uuid IN $in RETURN c.uuid AS c0, c.id AS c1
[coordinator] Projection[c.id]

