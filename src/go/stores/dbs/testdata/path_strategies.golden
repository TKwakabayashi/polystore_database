### any_point @prefilter
MATCH p=(a:Person {id: $x})-[:KNOWS*1..3]-(c:Person) WHERE any(n IN nodes(p) WHERE n.firstName = 'Dee') RETURN c.id
[mysql] columns=(_set0)
  SELECT `uuid` AS c0 FROM `Person` WHERE (`firstName` = ?)
  args: "Dee"
[neo4j] columns=(c.id)
  MATCH (a:Person) WHERE (a.id = $p0) MATCH _sp_r0 = (a)-[:KNOWS*1..3]-(c:Person) WHERE any(n IN [a] + nodes(_sp_r0)[1..-1] + [c] WHERE (n.uuid IN $p1)) WITH c.id AS v0 RETURN v0 AS c0
  params: p0=1(int64), p1=[]([]string)

### any_point @stepwise
MATCH p=(a:Person {id: $x})-[:KNOWS*1..3]-(c:Person) WHERE any(n IN nodes(p) WHERE n.firstName = 'Dee') RETURN c.id
[neo4j] columns=(c, p)
  MATCH (a:Person) WHERE (a.id = $p0) MATCH _sp_r0 = (a)-[:KNOWS*1..3]-(c:Person) RETURN c.uuid AS c0, {nodes: [_x IN [a] + nodes(_sp_r0)[1..-1] + [c] | _x.uuid], rels: [_x IN relationships(_sp_r0) | _x.uuid]} AS c1
  params: p0=1(int64)
(list) [mysql] columns=(_e, _e.firstName) in=(_e)
  SELECT `uuid` AS c0, `firstName` AS c1 FROM `Person` WHERE `uuid` IN (?)
  args: <in>
[coordinator] Filter(any(n IN nodes(p) WHERE (n.firstName = "Dee")))
[neo4j] columns=(c, c.id) in=(c)
  MATCH (c:Person) WHERE c.uuid IN $in RETURN c.uuid AS c0, c.id AS c1
[coordinator] Projection[c.id]

