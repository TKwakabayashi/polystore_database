### INLIST @graph
[graph] columns=(o.id, o.type)
  MATCH (o:Organisation) WHERE (o.type IN [$p0, $p1]) WITH o.id AS v0, o.type AS v1 RETURN v0 AS c0, v1 AS c1 ORDER BY v0 LIMIT 20
  params: p0="Company", p1="University"

### INLIST @relational
[relational] columns=(o.id, o.type)
  SELECT `id` AS c0, `type` AS c1 FROM `Organisation` WHERE `type` IN (?, ?) ORDER BY `id` ASC LIMIT 20
  args: "Company", "University"

### INLIST @document
[document] columns=(o.id, o.type)
  db.Organisation.aggregate([
    {$match: {type: {$in: ["Company", "University"]}}}
    {$project: {_id: 0(int), v0: "$id", v1: "$type", uuid: 1(int)}}
    {$sort: {v0: 1(int64)}}
    {$limit: {n: 20(int64)}}
    {$project: {_id: 0(int), c0: "$v0", c1: "$v1"}}
  ])

### INLIST @columnar
[columnar] columns=(o.id, o.type)
  SELECT "id" AS c0, "type" AS c1 FROM "Organisation" WHERE "type" IN (?, ?) ALLOW FILTERING
  args: "Company", "University"
[coordinator] Sort[o.id ASC]
[coordinator] Limit[20]

### INLIST @kvs
[kvs] columns=(o.id, o.type)
  KVS Organisation scan get=(type, id) filter (o.type IN ["Company", "University"])
[coordinator] Projection[o.id, o.type]
[coordinator] Sort[o.id ASC]
[coordinator] Limit[20]

