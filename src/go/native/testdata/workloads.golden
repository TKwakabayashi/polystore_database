### BI12 @graph
[graph] columns=(messageCount, personCount)
  MATCH (person:Person) OPTIONAL MATCH (person)<-[_r0:HAS_CREATOR]-(message:Message), _sp_r1 = (message)-[:REPLY_OF*0..]->(post:Post) WHERE (message.content IS NOT NULL) AND (message.length < $p0) AND (message.creationDate > $p1) AND (post.language IN [$p2, $p3]) WITH person AS person, count(message) AS v1 WITH v1 AS v2, count(person) AS v3 RETURN v2 AS c0, v3 AS c1 ORDER BY v3 DESC, v2 DESC
  params: p0=20(int64), p1=2010-07-22 00:00:00 +0000 UTC(time.Time), p2="ar", p3="hu"

