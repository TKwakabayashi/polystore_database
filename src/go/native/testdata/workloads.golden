### BI5 @graph
[graph] columns=(person.id, replyCount, likeCount, messageCount, score)
  MATCH (tag:Tag) WHERE (tag.name = $p0) MATCH (tag)<-[_r0:HAS_TAG]-(message:Message) MATCH (message)-[_r1:HAS_CREATOR]->(person:Person) OPTIONAL MATCH (message)<-[likes:LIKES]-(_n0:Person) WITH person AS person, message AS message, count(likes) AS v2 OPTIONAL MATCH (message)<-[_r2:REPLY_OF]-(reply:Comment) WITH person AS person, message AS message, v2 AS v5, count(reply) AS v6 WITH person AS person, count(message) AS v8, sum(v5) AS v9, sum(v6) AS v10 WITH person.id AS v11, v10 AS v12, v9 AS v13, v8 AS v14, ((($p1 * v8) + ($p2 * v10)) + ($p3 * v9)) AS v15 RETURN v11 AS c0, v12 AS c1, v13 AS c2, v14 AS c3, v15 AS c4 ORDER BY v15 DESC, v11 LIMIT 100
  params: p0="Abbas_I_of_Persia", p1=1(int64), p2=2(int64), p3=10(int64)

