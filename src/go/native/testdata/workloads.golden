### AGG5 @graph
[graph] columns=(cnt, mn, mx, sm, av)
  MATCH (o:Organisation) WHERE (o.id >= $p0) AND (o.id <= $p1) WITH count(*) AS v0, min(o.id) AS v1, max(o.id) AS v2, sum(o.id) AS v3, avg(o.id) AS v4 RETURN v0 AS c0, v1 AS c1, v2 AS c2, v3 AS c3, v4 AS c4
  params: p0=100(int64), p1=5000(int64)

### AGG5 @relational
[relational] columns=(cnt, mn, mx, sm, av)
  SELECT count(*) AS c0, min(`id`) AS c1, max(`id`) AS c2, sum(`id`) AS c3, avg(`id`) AS c4 FROM `Organisation` WHERE (`id` >= ?) AND (`id` <= ?)
  args: 100(int64), 5000(int64)

### AGG5 @document
[document] columns=(cnt, mn, mx, sm, av)
  db.Organisation.aggregate([
    {$match: {id: {$gte: 100(int64)}, id: {$lte: 5000(int64)}}}
    {$group: {_id: {}, a0: {$sum: 1(int64)}, a1: {$min: "$id"}, a2: {$max: "$id"}, a3: {$sum: "$id"}, a4: {$avg: "$id"}}}
    {$project: {_id: 0(int), v0: "$a0", v1: "$a1", v2: "$a2", v3: "$a3", v4: "$a4"}}
    {$project: {_id: 0(int), c0: "$v0", c1: "$v1", c2: "$v2", c3: "$v3", c4: "$v4"}}
  ])

### AGG5 @columnar
[columnar] columns=(cnt, mn, mx, sm, av)
  SELECT count(*) AS c0, min("id") AS c1, max("id") AS c2, sum("id") AS c3, avg("id") AS c4 FROM "Organisation" WHERE ("id" >= ?) AND ("id" <= ?) ALLOW FILTERING
  args: 100(int64), 5000(int64)

### AGG5 @kvs
[kvs] columns=(o.id)
  KVS Organisation scan get=(id) filter (o.id >= 100) filter (o.id <= 5000)
[coordinator] Aggregation[keys: ∅ | count(*) AS cnt, min(o.id) AS mn, max(o.id) AS mx, sum(o.id) AS sm, avg(o.id) AS av]

### AGG6 @graph
[graph] columns=(o.type, cnt, mn, mx)
  MATCH (o:Organisation) WITH o.type AS v0, count(*) AS v1, min(o.id) AS v2, max(o.id) AS v3 RETURN v0 AS c0, v1 AS c1, v2 AS c2, v3 AS c3 ORDER BY v1 DESC

### AGG6 @relational
[relational] columns=(o.type, cnt, mn, mx)
  SELECT `type` AS c0, count(*) AS c1, min(`id`) AS c2, max(`id`) AS c3 FROM `Organisation` GROUP BY `type` ORDER BY count(*) DESC

### AGG6 @document
[document] columns=(o.type, cnt, mn, mx)
  db.Organisation.aggregate([
    {$match: {}}
    {$group: {_id: {k0: "$type"}, a0: {$sum: 1(int64)}, a1: {$min: "$id"}, a2: {$max: "$id"}}}
    {$project: {_id: 0(int), v0: "$_id.k0", v1: "$a0", v2: "$a1", v3: "$a2"}}
    {$sort: {v1: -1(int64)}}
    {$project: {_id: 0(int), c0: "$v0", c1: "$v1", c2: "$v2", c3: "$v3"}}
  ])

