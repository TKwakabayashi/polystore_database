[graph] columns=(forum.id, forum.title, forum.creationDate, person.id, messageCount)
  MATCH (country:Place) WHERE (country.type = $p0) AND (country.name = $p1) MATCH (country)<-[_r0:IS_PART_OF]-(city:Place) MATCH (city)<-[_r1:IS_LOCATED_IN]-(person:Person) MATCH (person)<-[_r2:HAS_MODERATOR]-(forum:Forum) MATCH (forum)-[_r3:CONTAINER_OF]->(post:Post) MATCH _sp_r4 = (post)<-[:REPLY_OF*0..]-(message:Message) MATCH (message)-[_r5:HAS_TAG]->(tag:Tag) MATCH (tag)-[_r6:HAS_TYPE]->(tagclass:TagClass) WHERE (tagclass.name = $p2) WITH forum.id AS v0, forum.title AS v1, forum.creationDate AS v2, person.id AS v3, count(DISTINCT message.id) AS v4 RETURN v0 AS c0, v1 AS c1, v2 AS c2, v3 AS c3, v4 AS c4 ORDER BY v4 DESC, v0 LIMIT 20
  params: p0="Country", p1="Germany", p2="MusicalArtist"

