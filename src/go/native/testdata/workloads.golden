### AGG1 @graph
[graph] columns=(author.id, author.firstName, author.lastName, replyCount)
  MATCH (p:Person) WHERE (p.id = $p0) MATCH (p)<-[_r0:HAS_CREATOR]-(m:Message) MATCH (m)<-[_r1:REPLY_OF]-(comment:Comment) MATCH (comment)-[_r2:HAS_CREATOR]->(author:Person) WHERE _r0 <> _r2 WITH author.id AS v0, author.firstName AS v1, author.lastName AS v2, count(comment) AS v3 RETURN v0 AS c0, v1 AS c1, v2 AS c2, v3 AS c3 ORDER BY v3 DESC, v0 LIMIT 20
  params: p0=15393162799448(int64)

### AGG1 @relational
[relational] columns=(p)
  SELECT `uuid` AS c0 FROM `Person` WHERE (`id` = ?)
  args: 15393162799448(int64)
[graph] columns=(p, author, comment) in=(p)
  MATCH (p:Entity) WHERE p.uuid IN $in MATCH (p)<-[_r0:HAS_CREATOR]-(m:Message) MATCH (m)<-[_r1:REPLY_OF]-(comment:Comment) MATCH (comment)-[_r2:HAS_CREATOR]->(author:Person) WHERE _r0 <> _r2 RETURN p.uuid AS c0, author.uuid AS c1, comment.uuid AS c2
[relational] columns=(author, author.firstName, author.id, author.lastName) in=(author)
  SELECT `uuid` AS c0, `firstName` AS c1, `id` AS c2, `lastName` AS c3 FROM `Person` WHERE `uuid` IN (?)
  args: <in>
[coordinator] Aggregation[keys: author.id, author.firstName, author.lastName | count(comment) AS replyCount]
[coordinator] Sort[replyCount DESC, author.id ASC]
[coordinator] Limit[20]

