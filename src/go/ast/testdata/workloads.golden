### VARCMP
MATCH (a:Person {id: 15393162799448})-[_r0:KNOWS]-(b:Person)
  WHERE (a.id < b.id)
RETURN a.id AS a.id, b.id AS b.id, b.firstName AS b.firstName
  ORDER BY b.id ASC
