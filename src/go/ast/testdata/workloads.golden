### BI3
MATCH (country:Place {type: "Country", name: "Germany"})<-[_r0:IS_PART_OF]-(city:Place)<-[_r1:IS_LOCATED_IN]-(person:Person)<-[_r2:HAS_MODERATOR]-(forum:Forum)-[_r3:CONTAINER_OF]->(post:Post)<-[_r4:REPLY_OF*0..]-(message:Message)-[_r5:HAS_TAG]->(tag:Tag)-[_r6:HAS_TYPE]->(tagclass:TagClass {name: "MusicalArtist"})
RETURN forum.id AS forum.id, forum.title AS forum.title, forum.creationDate AS forum.creationDate, person.id AS person.id, count(DISTINCT message.id) AS messageCount
  ORDER BY messageCount DESC, forum.id ASC
  LIMIT 20

### BI5
MATCH (tag:Tag {name: "Abbas_I_of_Persia"})<-[_r0:HAS_TAG]-(message:Message)-[_r1:HAS_CREATOR]->(person:Person)
OPTIONAL MATCH (message)<-[likes:LIKES]-(_n0:Person)
WITH person AS person, message AS message, count(likes) AS likeCount
OPTIONAL MATCH (message)<-[_r2:REPLY_OF]-(reply:Comment)
WITH person AS person, message AS message, likeCount AS likeCount, count(reply) AS replyCount
WITH person AS person, count(message) AS messageCount, sum(likeCount) AS likeCount, sum(replyCount) AS replyCount
RETURN person.id AS person.id, replyCount AS replyCount, likeCount AS likeCount, messageCount AS messageCount, (((1 * messageCount) + (2 * replyCount)) + (10 * likeCount)) AS score
  ORDER BY score DESC, person.id ASC
  LIMIT 100

### BI6
MATCH (tag:Tag {name: "Arnold_Schwarzenegger"})<-[_r0:HAS_TAG]-(message1:Message)-[_r1:HAS_CREATOR]->(person1:Person)
OPTIONAL MATCH (message1)<-[_r2:LIKES]-(person2:Person)
OPTIONAL MATCH (person2)<-[_r3:HAS_CREATOR]-(message2:Message)<-[like:LIKES]-(person3:Person)
RETURN person1.id AS person1.id, count(DISTINCT like) AS authorityScore
  ORDER BY authorityScore DESC, person1.id ASC
  LIMIT 100

