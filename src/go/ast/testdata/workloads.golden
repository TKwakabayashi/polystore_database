### BI9
MATCH (person:Person)<-[_r0:HAS_CREATOR]-(post:Post)<-[_r1:REPLY_OF*0..]-(reply:Message)
  WHERE ((((post.creationDate >= "2010-01-01T00:00:00.000Z") AND (post.creationDate <= "2013-01-01T00:00:00.000Z")) AND (reply.creationDate >= "2010-01-01T00:00:00.000Z")) AND (reply.creationDate <= "2013-01-01T00:00:00.000Z"))
RETURN person.id AS person.id, person.firstName AS person.firstName, person.lastName AS person.lastName, count(DISTINCT post.id) AS threadCount, count(DISTINCT reply.id) AS messageCount
  ORDER BY messageCount DESC, person.id ASC
  LIMIT 100

