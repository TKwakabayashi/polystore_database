### IS6
MATCH (m:Message {id: 1030792151051})-[_r0:REPLY_OF*0..]->(_n0:Post)<-[_r1:CONTAINER_OF]-(f:Forum)-[_r2:HAS_MODERATOR]->(mod:Person)
RETURN f.id AS f.id, f.title AS f.title, mod.id AS mod.id, mod.firstName AS mod.firstName, mod.lastName AS mod.lastName

### IS7
MATCH (m:Message {id: 1030792151051})<-[_r0:REPLY_OF]-(c:Comment)-[_r1:HAS_CREATOR]->(p:Person)
OPTIONAL MATCH (m)-[_r2:HAS_CREATOR]->(a:Person)-[r:KNOWS]-(p)
RETURN c.id AS commentId, c.content AS commentContent, c.creationDate AS commentCreationDate, p.id AS replyAuthorId, p.firstName AS replyAuthorFirstName, p.lastName AS replyAuthorLastName, CASE r WHEN null THEN false ELSE true END AS replyAuthorKnowsOriginalMessageAuthor
  ORDER BY commentCreationDate DESC, replyAuthorId ASC

