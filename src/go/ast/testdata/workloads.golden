### IC12
MATCH (tag:Tag)-[_r0:HAS_TYPE|IS_SUBCLASS_OF*0..]->(baseTagClass:TagClass)
  WHERE ((tag.name = "Monarch") OR (baseTagClass.name = "Monarch"))
WITH collect(tag.id) AS tags
MATCH (_n0:Person {id: 15393162799448})-[_r1:KNOWS]-(friend:Person)<-[_r2:HAS_CREATOR]-(comment:Comment)-[_r3:REPLY_OF]->(_n1:Post)-[_r4:HAS_TAG]->(tag:Tag)
  WHERE (tag.id IN tags)
RETURN friend.id AS personId, friend.firstName AS personFirstName, friend.lastName AS personLastName, collect(DISTINCT tag.name) AS tagNames, count(DISTINCT comment) AS replyCount
  ORDER BY replyCount DESC, tointeger(personId) ASC
  LIMIT 20

