### IC6
MATCH (knownTag:Tag {name: "Genghis_Khan"})
WITH knownTag.id AS knownTagId
MATCH (person:Person {id: 15393162799448})-[_r0:KNOWS*1..2]-(friend)
  WHERE NOT((person = friend))
WITH knownTagId AS knownTagId, collect(DISTINCT friend) AS friends
UNWIND friends AS f
MATCH (f)<-[_r1:HAS_CREATOR]-(post:Post), (post)-[_r2:HAS_TAG]->(t:Tag {id: knownTagId}), (post)-[_r3:HAS_TAG]->(tag:Tag)
  WHERE NOT((t = tag))
WITH tag.name AS tagName, count(post) AS postCount
RETURN tagName AS tagName, postCount AS postCount
  ORDER BY postCount DESC, tagName ASC
  LIMIT 10

