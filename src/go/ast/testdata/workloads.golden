### BI12
MATCH (person:Person)
OPTIONAL MATCH (person)<-[_r0:HAS_CREATOR]-(message:Message)-[_r1:REPLY_OF*0..]->(post:Post)
  WHERE ((((message.content IS NOT NULL) AND (message.length < 20)) AND (message.creationDate > "2010-07-22T00:00:00.000Z")) AND (post.language IN ["ar", "hu"]))
WITH person AS person, count(message) AS messageCount
RETURN messageCount AS messageCount, count(person) AS personCount
  ORDER BY personCount DESC, messageCount DESC

