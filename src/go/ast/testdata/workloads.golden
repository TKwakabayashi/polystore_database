RETURN p.firstName AS p.firstName, p.lastName AS p.lastName, p.birthday AS p.birthday, p.locationIP AS p.locationIP, p.browserUsed AS p.browserUsed, c.id AS c.id, p.gender AS p.gender, p.creationDate AS p.creationDate

### IS2
MATCH (p:Person {id: 21990232558284})<-[_r0:HAS_CREATOR]-(m:Message)
RETURN m.id AS m.id, m.content AS m.content, m.imageFile AS m.imageFile, m.creationDate AS m.creationDate, p.id AS p.id, p.firstName AS p.firstName, p.lastName AS p.lastName
  ORDER BY m.creationDate DESC
  LIMIT 10

### IS3
MATCH (p:Person {id: 21990232558284})-[r:KNOWS]-(friend:Person)
RETURN friend.id AS friend.id, friend.firstName AS friend.firstName, friend.lastName AS friend.lastName, r.creationDate AS r.creationDate
  ORDER BY r.creationDate DESC, friend.id ASC

