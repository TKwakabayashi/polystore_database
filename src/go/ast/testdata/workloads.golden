### PATHFILT
MATCH p = (person:Person {id: 17592186049378})-[_r0:KNOWS*1..3]-(other:Person)
  WHERE (all(r IN relationships(p) WHERE (r.creationDate > "2010-01-01T00:00:00.000Z")) AND (length(p) <= 3))
RETURN other.id AS other.id, other.firstName AS other.firstName
  ORDER BY other.id ASC
  LIMIT 20

### Q11
MATCH (p:Person {id: 15393162799448})-[_r0:KNOWS*1..3]-(friend:Person)-[work:WORK_AT]->(comp:Organisation {type: "Company"})-[_r1:IS_LOCATED_IN]->(_n0:Place {type: "Country", name: "Germany"})
  WHERE (work.workFrom < 2008)
RETURN friend.id AS friend.id, friend.firstName AS friend.firstName, friend.lastName AS friend.lastName, comp.name AS comp.name, work.workFrom AS work.workFrom
  ORDER BY work.workFrom ASC, friend.id ASC, comp.name DESC
