### AGG1
MATCH (p:Person {id: 15393162799448})<-[_r0:HAS_CREATOR]-(m:Message)<-[_r1:REPLY_OF]-(comment:Comment)-[_r2:HAS_CREATOR]->(author:Person)
RETURN author.id AS author.id, author.firstName AS author.firstName, author.lastName AS author.lastName, count(comment) AS replyCount
  ORDER BY replyCount DESC, author.id ASC
  LIMIT 20

### AGG2
MATCH (p:Person {id: 15393162799448})-[_r0:KNOWS]-(friend:Person)<-[_r1:HAS_CREATOR]-(m:Message)
RETURN friend.id AS friend.id, friend.firstName AS friend.firstName, count(m) AS msgCount, avg(m.length) AS avgLen, max(m.length) AS maxLen
  ORDER BY msgCount DESC, friend.id ASC
  LIMIT 20

### AGG3
MATCH (p:Person {id: 15393162799448})-[_r0:KNOWS]-(friend:Person)<-[_r1:HAS_CREATOR]-(m:Message)
RETURN count(*) AS total, count(DISTINCT friend.id) AS friends, sum(m.length) AS totLen, avg(m.length) AS avgLen, min(m.length) AS minLen, max(m.length) AS maxLen

### AGG4
MATCH (p:Person {id: 15393162799448})<-[_r0:HAS_CREATOR]-(m:Message)
  WHERE ((m.length >= 50) AND (m.length <= 200))
RETURN m.id AS m.id, m.length AS m.length
  ORDER BY m.length DESC, m.id ASC
  LIMIT 20

### AGG5
MATCH (o:Organisation)
  WHERE ((o.id >= 100) AND (o.id <= 5000))
RETURN count(*) AS cnt, min(o.id) AS mn, max(o.id) AS mx, sum(o.id) AS sm, avg(o.id) AS av

### AGG6
MATCH (o:Organisation)
RETURN o.type AS o.type, count(*) AS cnt, min(o.id) AS mn, max(o.id) AS mx
  ORDER BY cnt DESC

