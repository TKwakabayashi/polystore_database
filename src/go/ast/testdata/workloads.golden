### MULTIPAT
MATCH (p:Person {id: 15393162799448})-[_r0:KNOWS]-(friend:Person), (friend)-[_r1:IS_LOCATED_IN]->(city:Place)
RETURN friend.id AS friend.id, friend.firstName AS friend.firstName, city.id AS city.id
  ORDER BY friend.id ASC
