MATCH (_n0:Person {id: 15393162799448})-[_r0:KNOWS]-(friend:Person)<-[_r1:HAS_CREATOR]-(m:Message)
  WHERE (m.creationDate <= "2011-06-16T00:00:00.000Z")
RETURN friend.id AS friend.id, friend.firstName AS friend.firstName, friend.lastName AS friend.lastName, m.id AS m.id, coalesce(m.content, m.imageFile) AS coalesce(m.content, m.imageFile), m.creationDate AS m.creationDate
  ORDER BY m.creationDate DESC, m.id ASC
