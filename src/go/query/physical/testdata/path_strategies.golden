        Fetch[mysql] in=(_set0) out=(_set0, _set0.lastName)
          : GetProperty(_set0.lastName) [node:Person]
          :   Argument(_set0)
          StoreQuery[mongo] out=(_set0, _set0.gender)
            : GetProperty(_set0.gender) [node:Person]
