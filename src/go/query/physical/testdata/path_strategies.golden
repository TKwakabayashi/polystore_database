### all_rels @prefilter
MATCH p=(a:Person {id: $x})-[:KNOWS*1..3]-(c:Person) WHERE all(r IN relationships(p) WHERE r.creationDate > '2012-01-01T00:00:00Z') RETURN c.id
Coord Projection[c.id]
  Fetch[neo4j] in=(c) out=(c, c.id)
    : GetProperty(c.id) [node:Person]
    :   Argument(c)
    Coord Filter(all(r IN relationships(_seg__r0) WHERE (r.creationDate > 2012-01-01 00:00:00 +0000 UTC)))
      ListFetch[mysql] _seg__r0.rels.creationDate from _seg__r0 [elem:KNOWS]
        StoreQuery[neo4j] out=(_seg__r0, c)
          : VarLengthExpand((a)-[_r0:KNOWS*1..3]-(c:Person)) emit _seg__r0
          :   Filter((a.id = 1))
          :     GetProperty(a.id) [node:Person]
          :       EntityScan(a:Person)

