### count_weighted @stepwise
MATCH p=(a:Person {id: $x})-[:KNOWS*1..3]-(c:Person) WHERE all(n IN nodes(p) WHERE n.gender = 'male') RETURN count(*) AS n
Coord Aggregation[keys: ∅ | count(*) AS n]
  StoreQuery[mongo] in=(c) out=(c)
    : Filter((c.gender = "male"))
    :   GetProperty(c.gender) [node:Person]
    :     Argument(c)
    StepExpand((a)-[_r0:KNOWS*1..3]-(c:Person)) seg[all(n IN nodes WHERE (n.gender = "male"))] weighted
      check nodes: (_ht.gender = "male")
      hop
        StoreQuery[neo4j] in=(_hf) out=(_hf, _hr, _ht)
          : Expand((_hf)-[_hr:KNOWS]-(_ht))
          :   Argument(_hf)
      fetch ListFetch[mongo] _ht.nodes.gender from _ht [elem:Person]
      StoreQuery[neo4j] in=(a) out=(a)
        : Filter((a.id = 1))
        :   GetProperty(a.id) [node:Person]
        :     Argument(a)
        StoreQuery[mongo] out=(a)
          : Filter((a.gender = "male"))
          :   GetProperty(a.gender) [node:Person]
          :     EntityScan(a:Person)

### all_graph @prefilter
MATCH p=(a:Person {id: $x})-[:KNOWS*1..3]-(c:Person) WHERE all(n IN nodes(p) WHERE n.gender = 'male') RETURN c.id
StoreQuery[neo4j] out=(c.id)
  : Projection[c.id]
  :   GetProperty(c.id) [node:Person]
  :     Filter((c.gender = "male"))
  :       GetProperty(c.gender) [node:Person]
  :         VarLengthExpand((a)-[_r0:KNOWS*1..3]-(c:Person)) seg[all(n IN nodes WHERE (n.gender = "male"))]
  :           Filter((a.id = 1))
  :             GetProperty(a.id) [node:Person]
  :               Filter((a.gender = "male"))
  :                 GetProperty(a.gender) [node:Person]
  :                   EntityScan(a:Person)

### all_graph @stepwise
MATCH p=(a:Person {id: $x})-[:KNOWS*1..3]-(c:Person) WHERE all(n IN nodes(p) WHERE n.gender = 'male') RETURN c.id
StoreQuery[neo4j] out=(c.id)
  : Projection[c.id]
  :   GetProperty(c.id) [node:Person]
  :     Filter((c.gender = "male"))
  :       GetProperty(c.gender) [node:Person]
  :         VarLengthExpand((a)-[_r0:KNOWS*1..3]-(c:Person)) seg[all(n IN nodes WHERE (n.gender = "male"))]
  :           Filter((a.id = 1))
  :             GetProperty(a.id) [node:Person]
  :               Filter((a.gender = "male"))
  :                 GetProperty(a.gender) [node:Person]
  :                   EntityScan(a:Person)

### quantified_nodes @prefilter
MATCH (a:Person {id: $x}) ((n:Person)-[:KNOWS]-(m:Person) WHERE m.gender = 'male'){1,3} (c) RETURN c.id
WithSets[$set0]
  set $set0 = _set0 of
    StoreQuery[mongo] out=(_set0)
      : Projection[_set0]
      :   Filter((_set0.gender = "male"))
      :     GetProperty(_set0.gender) [node:Person]
      :       EntityScan(_set0:Person)
  Coord Projection[c.id]
    Fetch[neo4j] in=(c) out=(c, c.id)
      : GetProperty(c.id) [node:Person]
      :   Argument(c)
      StoreQuery[mongo] in=(c) out=(c)
        : Filter((c.gender = "male"))
        :   GetProperty(c.gender) [node:Person]
        :     Argument(c)
        StoreQuery[neo4j] out=(c) weighted
          : VarLengthExpand((a)-[_q0:KNOWS*1..3]-(c:Person)) seg[all(n IN nodes WHERE n IN $set0)] inner:Person
          :   Filter((a.id = 1))
          :     GetProperty(a.id) [node:Person]
          :       EntityScan(a:Person)

### quantified_nodes @stepwise
MATCH (a:Person {id: $x}) ((n:Person)-[:KNOWS]-(m:Person) WHERE m.gender = 'male'){1,3} (c) RETURN c.id
Coord Projection[c.id]
  Fetch[neo4j] in=(c) out=(c, c.id)
    : GetProperty(c.id) [node:Person]
    :   Argument(c)
    StoreQuery[mongo] in=(c) out=(c)
      : Filter((c.gender = "male"))
      :   GetProperty(c.gender) [node:Person]
      :     Argument(c)
      StepExpand((a)-[_q0:KNOWS*1..3]-(c:Person)) seg[all(n IN nodes WHERE (n.gender = "male"))] inner:Person weighted
        check nodes: (_ht.gender = "male")
        hop
          StoreQuery[neo4j] in=(_hf) out=(_hf, _hr, _ht)
            : Expand((_hf)-[_hr:KNOWS]-(_ht))
            :   Argument(_hf)
        fetch ListFetch[mongo] _ht.nodes.gender from _ht [elem:Person]
        StoreQuery[neo4j] out=(a)
          : Filter((a.id = 1))
          :   GetProperty(a.id) [node:Person]
          :     EntityScan(a:Person)

### quantified_rels @prefilter
MATCH (a:Person {id: $x})-[r:KNOWS WHERE r.creationDate > '2012-01-01T00:00:00Z']-{1,3}(c:Person) RETURN c.id
Coord Projection[c.id]
  Fetch[neo4j] in=(c) out=(c, c.id)
    : GetProperty(c.id) [node:Person]
    :   Argument(c)
    Coord Filter(all(r IN relationships(_seg__q0) WHERE (r.creationDate > 2012-01-01 00:00:00 +0000 UTC)))
      ListFetch[mysql] _seg__q0.rels.creationDate from _seg__q0 [elem:KNOWS]
        StoreQuery[neo4j] out=(_seg__q0, c)
          : VarLengthExpand((a)-[_q0:KNOWS*1..3]-(c:Person)) emit _seg__q0
          :   Filter((a.id = 1))
          :     GetProperty(a.id) [node:Person]
          :       EntityScan(a:Person)

### quantified_rels @stepwise
MATCH (a:Person {id: $x})-[r:KNOWS WHERE r.creationDate > '2012-01-01T00:00:00Z']-{1,3}(c:Person) RETURN c.id
Coord Projection[c.id]
  Fetch[neo4j] in=(c) out=(c, c.id)
    : GetProperty(c.id) [node:Person]
    :   Argument(c)
    StepExpand((a)-[_q0:KNOWS*1..3]-(c:Person)) seg[all(r IN rels WHERE (r.creationDate > 2012-01-01 00:00:00 +0000 UTC))] weighted
      check rels: (_hr.creationDate > 2012-01-01 00:00:00 +0000 UTC)
      hop
        StoreQuery[neo4j] in=(_hf) out=(_hf, _hr, _ht)
          : Expand((_hf)-[_hr:KNOWS]-(_ht))
          :   Argument(_hf)
      fetch ListFetch[mysql] _hr.rels.creationDate from _hr [elem:KNOWS]
      StoreQuery[neo4j] out=(a)
        : Filter((a.id = 1))
        :   GetProperty(a.id) [node:Person]
        :     EntityScan(a:Person)

