      Coord Filter(NOT(((c.gender = "male") AND (c.lastName = "Lee"))))
        Fetch[mysql] in=(c) out=(c, c.lastName)
          : GetProperty(c.lastName) [node:Person]
          :   Argument(c)
          Fetch[mongo] in=(c) out=(c, c.gender)
            : GetProperty(c.gender) [node:Person]
            :   Argument(c)
            StoreQuery[neo4j] in=(a) out=(a, c) weighted
              : VarLengthExpand((a)-[_r0:KNOWS*1..3]-(c:Person)) seg[all(n IN nodes WHERE n IN $set0)]
              :   Filter((a.id = 1))
              :     GetProperty(a.id) [node:Person]
              :       Argument(a)
              Coord Filter(NOT(((a.gender = "male") AND (a.lastName = "Lee"))))
                Fetch[mysql] in=(a) out=(a, a.lastName)
                  : GetProperty(a.lastName) [node:Person]
                  :   Argument(a)
                  StoreQuery[mongo] out=(a, a.gender)
                    : GetProperty(a.gender) [node:Person]
                    :   EntityScan(a:Person)

### none_two_stores @stepwise
MATCH p=(a:Person {id: $x})-[:KNOWS*1..3]-(c:Person) WHERE none(n IN nodes(p) WHERE n.gender = 'male' AND n.lastName = 'Lee') RETURN c.id
Coord Projection[c.id]
  Fetch[neo4j] in=(c) out=(c, c.id)
    : GetProperty(c.id) [node:Person]
    :   Argument(c)
    Coord Filter(NOT(((c.gender = "male") AND (c.lastName = "Lee"))))
      Fetch[mysql] in=(c) out=(c, c.lastName)
        : GetProperty(c.lastName) [node:Person]
        :   Argument(c)
        Fetch[mongo] in=(c) out=(c, c.gender)
          : GetProperty(c.gender) [node:Person]
          :   Argument(c)
          StepExpand((a)-[_r0:KNOWS*1..3]-(c:Person)) seg[all(n IN nodes WHERE NOT(((n.gender = "male") AND (n.lastName = "Lee"))))] weighted
            check nodes: NOT(((_ht.gender = "male") AND (_ht.lastName = "Lee")))
            hop
              StoreQuery[neo4j] in=(_hf) out=(_hf, _hr, _ht)
                : Expand((_hf)-[_hr:KNOWS]-(_ht))
                :   Argument(_hf)
            fetch ListFetch[mongo] _ht.nodes.gender from _ht [elem:Person]
            fetch ListFetch[mysql] _ht.nodes.lastName from _ht [elem:Person]
            StoreQuery[neo4j] in=(a) out=(a)
              : Filter((a.id = 1))
              :   GetProperty(a.id) [node:Person]
              :     Argument(a)
              Coord Filter(NOT(((a.gender = "male") AND (a.lastName = "Lee"))))
                Fetch[mysql] in=(a) out=(a, a.lastName)
                  : GetProperty(a.lastName) [node:Person]
                  :   Argument(a)
                  StoreQuery[mongo] out=(a, a.gender)
                    : GetProperty(a.gender) [node:Person]
                    :   EntityScan(a:Person)

