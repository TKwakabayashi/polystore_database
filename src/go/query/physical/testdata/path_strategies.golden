### fixed_and_var @prefilter
MATCH p=(a:Person {id: $x})-[:KNOWS]->(b:Person)-[:KNOWS*1..3]-(c:Person) WHERE all(n IN nodes(p) WHERE n.gender = 'male') AND length(p) <= 3 RETURN c.id
WithSets[$set0]
  set $set0 = _set0 of
    StoreQuery[mongo] out=(_set0)
      : Projection[_set0]
      :   Filter((_set0.gender = "male"))
      :     GetProperty(_set0.gender) [node:Person]
      :       EntityScan(_set0:Person)
  Coord Projection[c.id]
    Fetch[neo4j] in=(c) out=(c, c.id)
      : GetProperty(c.id) [node:Person]
      :   Argument(c)
      StoreQuery[mongo] in=(c) out=(c)
        : Filter((c.gender = "male"))
        :   GetProperty(c.gender) [node:Person]
        :     Argument(c)
        StoreQuery[mongo] in=(b) out=(b)
          : Filter((b.gender = "male"))
          :   GetProperty(b.gender) [node:Person]
          :     Argument(b)
          StoreQuery[neo4j] in=(a) out=(a, b, c) weighted
            : RelUniqueFilter[_r0, _seg__r1]
            :   VarLengthExpand((b)-[_r1:KNOWS*1..2]-(c:Person)) seg[all(n IN nodes WHERE n IN $set0)]
            :     Expand((a)-[_r0:KNOWS]->(b:Person))
            :       Filter((a.id = 1))
            :         GetProperty(a.id) [node:Person]
            :           Argument(a)
            StoreQuery[mongo] out=(a)
              : Filter((a.gender = "male"))
              :   GetProperty(a.gender) [node:Person]
              :     EntityScan(a:Person)

