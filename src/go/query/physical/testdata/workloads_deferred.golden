  Fetch[leveldb] in=(m) out=(m, m.id, m.length)
    : GetProperty(m.length) [node:Message]
    :   GetProperty(m.id) [node:Message]
    :     Argument(m)
    StoreQuery[leveldb] in=(post) out=(post, post.creationDate, post.id)
      : GetProperty(post.creationDate) [node:Message]
      :   GetProperty(post.id) [node:Message]
      :     Filter((post.language = "zh"))
      :       GetProperty(post.language) [node:Message]
      :         Argument(post)
      StoreQuery[neo4j] in=(m) out=(m, post) weighted
        : VarLengthExpand((m)-[_r0:REPLY_OF*0..]->(post:Post))
        :   Argument(m)
        StoreQuery[leveldb] out=(m)
          : Filter((m.creationDate < 2012-11-02 00:00:00 +0000 UTC))
          :   Filter((m.creationDate >= 2012-11-01 00:00:00 +0000 UTC))
          :     GetProperty(m.creationDate) [node:Message]
          :       EntityScan(m:Message)

