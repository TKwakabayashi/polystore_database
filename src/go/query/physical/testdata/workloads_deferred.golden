### AGG2 @graph
StoreQuery[neo4j] out=(friend.id, friend.firstName, msgCount, avgLen, maxLen)
  : Limit[20]
  :   Sort[msgCount DESC, friend.id ASC]
  :     Aggregation[keys: friend.id, friend.firstName | count(m) AS msgCount, avg(m.length) AS avgLen, max(m.length) AS maxLen]
  :       GetProperty(m.length) [node:Message]
  :         GetProperty(friend.firstName) [node:Person]
  :           GetProperty(friend.id) [node:Person]
  :             Expand((friend)<-[_r1:HAS_CREATOR]-(m:Message))
  :               Expand((p)-[_r0:KNOWS]-(friend:Person))
  :                 Filter((p.id = 15393162799448))
  :                   GetProperty(p.id) [node:Person]
  :                     EntityScan(p:Person)

### AGG2 @relational
Coord Limit[20]
  Coord Sort[msgCount DESC, friend.id ASC]
    Coord Aggregation[keys: friend.id, friend.firstName | count(m) AS msgCount, avg(m.length) AS avgLen, max(m.length) AS maxLen]
      Fetch[mysql] in=(m) out=(m, m.length)
        : GetProperty(m.length) [node:Message]
        :   Argument(m)
        Fetch[mysql] in=(friend) out=(friend, friend.firstName, friend.id)
          : GetProperty(friend.firstName) [node:Person]
          :   GetProperty(friend.id) [node:Person]
          :     Argument(friend)
          StoreQuery[neo4j] in=(p) out=(p, friend, m)
            : Expand((friend)<-[_r1:HAS_CREATOR]-(m:Message))
            :   Expand((p)-[_r0:KNOWS]-(friend:Person))
            :     Argument(p)
            StoreQuery[mysql] out=(p)
              : Filter((p.id = 15393162799448))
              :   GetProperty(p.id) [node:Person]
              :     EntityScan(p:Person)

