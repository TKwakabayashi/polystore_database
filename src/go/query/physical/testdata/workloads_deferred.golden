  Coord Sort[replyCount DESC, tointeger(personId) ASC]
    Coord Aggregation[keys: friend.id AS personId, friend.firstName AS personFirstName, friend.lastName AS personLastName | collect(DISTINCT tag.name) AS tagNames, count(DISTINCT comment) AS replyCount]
      Fetch[neo4j] in=(tag) out=(tag, tag.name)
        : GetProperty(tag.name) [node:Tag]
        :   Argument(tag)
        Fetch[neo4j] in=(friend) out=(friend, friend.firstName, friend.id, friend.lastName)
          : GetProperty(friend.lastName) [node:Person]
          :   GetProperty(friend.firstName) [node:Person]
          :     GetProperty(friend.id) [node:Person]
          :       Argument(friend)
          Coord Filter((tag.id IN tags))
            Fetch[neo4j] in=(tag) out=(tag, tag.id)
              : GetProperty(tag.id) [node:Tag]
              :   Argument(tag)
              Coord NodeHashJoin[cartesian]
                StoreQuery[neo4j] out=(tags)
                  : Aggregation[keys: ∅ | collect(tag.id) AS tags]
                  :   GetProperty(tag.id) [node:Tag]
                  :     Filter(((tag.name = "Monarch") OR (baseTagClass.name = "Monarch")))
                  :       GetProperty(baseTagClass.name) [node:TagClass]
                  :         GetProperty(tag.name) [node:Tag]
                  :           VarLengthExpand((tag)-[_r0:HAS_TYPE|IS_SUBCLASS_OF*0..]->(baseTagClass:TagClass))
                  :             EntityScan(tag:Tag)
                StoreQuery[neo4j] out=(comment, friend, tag)
                  : Expand((_n1)-[_r4:HAS_TAG]->(tag:Tag))
                  :   Expand((comment)-[_r3:REPLY_OF]->(_n1:Post))
                  :     Expand((friend)<-[_r2:HAS_CREATOR]-(comment:Comment))
                  :       Expand((_n0)-[_r1:KNOWS]-(friend:Person))
                  :         Filter((_n0.id = 15393162799448))
                  :           GetProperty(_n0.id) [node:Person]
                  :             EntityScan(_n0:Person)

