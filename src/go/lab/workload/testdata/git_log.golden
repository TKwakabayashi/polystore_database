## GIT1 — Short walks on deep chains: the cost when the sort key and output-only columns are off graph
traits: start=filtered scan hops=1..3 fan-out=low variable-length Top-20 | R0 output: c.sha, a.subject | R1 start: c.files_changed | R6 aggregate / sort: a.committed_date, a.sha

### GIT1 @graph
StoreQuery[neo4j] out=(c.sha, a.sha, a.subject)
  : Projection[c.sha, a.sha, a.subject]
  :   GetProperty(a.subject) [node:Commit]
  :     GetProperty(c.sha) [node:Commit]
  :       Limit[20]
  :         Sort[_sort0 DESC, a.sha ASC]
  :           Projection[a.sha, a.committed_date AS _sort0, a, c]
  :             GetProperty(a.committed_date) [node:Commit]
  :               GetProperty(a.sha) [node:Commit]
  :                 VarLengthExpand((c)-[_r0:PARENT*1..3]->(a:Commit))
  :                   Filter((c.files_changed >= 200))
  :                     GetProperty(c.files_changed) [node:Commit]
  :                       EntityScan(c:Commit)

### GIT1 @relational
Coord Projection[c.sha, a.sha, a.subject]
  Fetch[mysql] in=(a) out=(a, a.subject)
    : GetProperty(a.subject) [node:Commit]
    :   Argument(a)
    Fetch[mysql] in=(c) out=(c, c.sha)
      : GetProperty(c.sha) [node:Commit]
      :   Argument(c)
      Coord Limit[20]
        Coord Sort[_sort0 DESC, a.sha ASC]
          Coord Projection[a.sha, a.committed_date AS _sort0, a, c]
            Fetch[mysql] in=(a) out=(a, a.committed_date, a.sha)
              : GetProperty(a.committed_date) [node:Commit]
              :   GetProperty(a.sha) [node:Commit]
              :     Argument(a)
              StoreQuery[neo4j] in=(c) out=(c, a) weighted
                : VarLengthExpand((c)-[_r0:PARENT*1..3]->(a:Commit))
                :   Argument(c)
                StoreQuery[mysql] out=(c)
                  : Filter((c.files_changed >= 200))
                  :   GetProperty(c.files_changed) [node:Commit]
                  :     EntityScan(c:Commit)

### GIT1 @document
Coord Projection[c.sha, a.sha, a.subject]
  Fetch[mongo] in=(a) out=(a, a.subject)
    : GetProperty(a.subject) [node:Commit]
    :   Argument(a)
    Fetch[mongo] in=(c) out=(c, c.sha)
      : GetProperty(c.sha) [node:Commit]
      :   Argument(c)
      Coord Limit[20]
        Coord Sort[_sort0 DESC, a.sha ASC]
          Coord Projection[a.sha, a.committed_date AS _sort0, a, c]
            Fetch[mongo] in=(a) out=(a, a.committed_date, a.sha)
              : GetProperty(a.committed_date) [node:Commit]
              :   GetProperty(a.sha) [node:Commit]
              :     Argument(a)
              StoreQuery[neo4j] in=(c) out=(c, a) weighted
                : VarLengthExpand((c)-[_r0:PARENT*1..3]->(a:Commit))
                :   Argument(c)
                StoreQuery[mongo] out=(c)
                  : Filter((c.files_changed >= 200))
                  :   GetProperty(c.files_changed) [node:Commit]
                  :     EntityScan(c:Commit)

### GIT1 @columnar
Coord Projection[c.sha, a.sha, a.subject]
  Fetch[clickhouse] in=(a) out=(a, a.subject)
    : GetProperty(a.subject) [node:Commit]
    :   Argument(a)
    Fetch[clickhouse] in=(c) out=(c, c.sha)
      : GetProperty(c.sha) [node:Commit]
      :   Argument(c)
      Coord Limit[20]
        Coord Sort[_sort0 DESC, a.sha ASC]
          Coord Projection[a.sha, a.committed_date AS _sort0, a, c]
            Fetch[clickhouse] in=(a) out=(a, a.committed_date, a.sha)
              : GetProperty(a.committed_date) [node:Commit]
              :   GetProperty(a.sha) [node:Commit]
              :     Argument(a)
              StoreQuery[neo4j] in=(c) out=(c, a) weighted
                : VarLengthExpand((c)-[_r0:PARENT*1..3]->(a:Commit))
                :   Argument(c)
                StoreQuery[clickhouse] out=(c)
                  : Filter((c.files_changed >= 200))
                  :   GetProperty(c.files_changed) [node:Commit]
                  :     EntityScan(c:Commit)

### GIT1 @widecolumn
Coord Projection[c.sha, a.sha, a.subject]
  Fetch[cassandra] in=(a) out=(a, a.subject)
    : GetProperty(a.subject) [node:Commit]
    :   Argument(a)
    Fetch[cassandra] in=(c) out=(c, c.sha)
      : GetProperty(c.sha) [node:Commit]
      :   Argument(c)
      Coord Limit[20]
        Coord Sort[_sort0 DESC, a.sha ASC]
          Coord Projection[a.sha, a.committed_date AS _sort0, a, c]
            Fetch[cassandra] in=(a) out=(a, a.committed_date, a.sha)
              : GetProperty(a.committed_date) [node:Commit]
              :   GetProperty(a.sha) [node:Commit]
              :     Argument(a)
              StoreQuery[neo4j] in=(c) out=(c, a) weighted
                : VarLengthExpand((c)-[_r0:PARENT*1..3]->(a:Commit))
                :   Argument(c)
                StoreQuery[cassandra] out=(c)
                  : Filter((c.files_changed >= 200))
                  :   GetProperty(c.files_changed) [node:Commit]
                  :     EntityScan(c:Commit)

### GIT1 @kvs
Coord Projection[c.sha, a.sha, a.subject]
  Fetch[leveldb] in=(a) out=(a, a.subject)
    : GetProperty(a.subject) [node:Commit]
    :   Argument(a)
    Fetch[leveldb] in=(c) out=(c, c.sha)
      : GetProperty(c.sha) [node:Commit]
      :   Argument(c)
      Coord Limit[20]
        Coord Sort[_sort0 DESC, a.sha ASC]
          Coord Projection[a.sha, a.committed_date AS _sort0, a, c]
            Fetch[leveldb] in=(a) out=(a, a.committed_date, a.sha)
              : GetProperty(a.committed_date) [node:Commit]
              :   GetProperty(a.sha) [node:Commit]
              :     Argument(a)
              StoreQuery[neo4j] in=(c) out=(c, a) weighted
                : VarLengthExpand((c)-[_r0:PARENT*1..3]->(a:Commit))
                :   Argument(c)
                StoreQuery[leveldb] out=(c)
                  : Filter((c.files_changed >= 200))
                  :   GetProperty(c.files_changed) [node:Commit]
                  :     EntityScan(c:Commit)

## GIT2 — The cost of extracting paths (paths x length) when a whole-path condition is off graph
traits: start=filtered scan hops=1..5 fan-out=low variable-length aggregate Top-20 | R1 start: c.files_changed | R4 path: x.deletions | R6 aggregate / sort: a.sha

### GIT2 @graph
StoreQuery[neo4j] out=(a.sha, paths)
  : Limit[20]
  :   Sort[paths DESC, a.sha ASC]
  :     Aggregation[keys: a.sha | count(*) AS paths]
  :       GetProperty(a.sha) [node:Commit]
  :         Filter((a.deletions < 1000))
  :           GetProperty(a.deletions) [node:Commit]
  :             VarLengthExpand((c)-[_r0:PARENT*1..5]->(a:Commit)) seg[all(x IN nodes WHERE (x.deletions < 1000))]
  :               Filter((c.deletions < 1000))
  :                 GetProperty(c.deletions) [node:Commit]
  :                   Filter((c.files_changed >= 200))
  :                     GetProperty(c.files_changed) [node:Commit]
  :                       EntityScan(c:Commit)

### GIT2 @relational
Coord Limit[20]
  Coord Sort[paths DESC, a.sha ASC]
    Coord Aggregation[keys: a.sha | count(*) AS paths]
      StoreQuery[mysql] in=(a) out=(a, a.sha)
        : GetProperty(a.sha) [node:Commit]
        :   Filter((a.deletions < 1000))
        :     GetProperty(a.deletions) [node:Commit]
        :       Argument(a)
        Coord Filter(all(x IN nodes(_seg__r0) WHERE (x.deletions < 1000)))
          ListFetch[mysql] _seg__r0.nodes.deletions from _seg__r0 [elem:Commit]
            StoreQuery[neo4j] in=(c) out=(c, _seg__r0, a)
              : VarLengthExpand((c)-[_r0:PARENT*1..5]->(a:Commit)) emit _seg__r0
              :   Argument(c)
              StoreQuery[mysql] out=(c)
                : Filter((c.deletions < 1000))
                :   GetProperty(c.deletions) [node:Commit]
                :     Filter((c.files_changed >= 200))
                :       GetProperty(c.files_changed) [node:Commit]
                :         EntityScan(c:Commit)

### GIT2 @document
Coord Limit[20]
  Coord Sort[paths DESC, a.sha ASC]
    Coord Aggregation[keys: a.sha | count(*) AS paths]
      StoreQuery[mongo] in=(a) out=(a, a.sha)
        : GetProperty(a.sha) [node:Commit]
        :   Filter((a.deletions < 1000))
        :     GetProperty(a.deletions) [node:Commit]
        :       Argument(a)
        Coord Filter(all(x IN nodes(_seg__r0) WHERE (x.deletions < 1000)))
          ListFetch[mongo] _seg__r0.nodes.deletions from _seg__r0 [elem:Commit]
            StoreQuery[neo4j] in=(c) out=(c, _seg__r0, a)
              : VarLengthExpand((c)-[_r0:PARENT*1..5]->(a:Commit)) emit _seg__r0
              :   Argument(c)
              StoreQuery[mongo] out=(c)
                : Filter((c.deletions < 1000))
                :   GetProperty(c.deletions) [node:Commit]
                :     Filter((c.files_changed >= 200))
                :       GetProperty(c.files_changed) [node:Commit]
                :         EntityScan(c:Commit)

### GIT2 @columnar
Coord Limit[20]
  Coord Sort[paths DESC, a.sha ASC]
    Coord Aggregation[keys: a.sha | count(*) AS paths]
      StoreQuery[clickhouse] in=(a) out=(a, a.sha)
        : GetProperty(a.sha) [node:Commit]
        :   Filter((a.deletions < 1000))
        :     GetProperty(a.deletions) [node:Commit]
        :       Argument(a)
        Coord Filter(all(x IN nodes(_seg__r0) WHERE (x.deletions < 1000)))
          ListFetch[clickhouse] _seg__r0.nodes.deletions from _seg__r0 [elem:Commit]
            StoreQuery[neo4j] in=(c) out=(c, _seg__r0, a)
              : VarLengthExpand((c)-[_r0:PARENT*1..5]->(a:Commit)) emit _seg__r0
              :   Argument(c)
              StoreQuery[clickhouse] out=(c)
                : Filter((c.deletions < 1000))
                :   GetProperty(c.deletions) [node:Commit]
                :     Filter((c.files_changed >= 200))
                :       GetProperty(c.files_changed) [node:Commit]
                :         EntityScan(c:Commit)

### GIT2 @widecolumn
Coord Limit[20]
  Coord Sort[paths DESC, a.sha ASC]
    Coord Aggregation[keys: a.sha | count(*) AS paths]
      StoreQuery[cassandra] in=(a) out=(a, a.sha)
        : GetProperty(a.sha) [node:Commit]
        :   Filter((a.deletions < 1000))
        :     GetProperty(a.deletions) [node:Commit]
        :       Argument(a)
        Coord Filter(all(x IN nodes(_seg__r0) WHERE (x.deletions < 1000)))
          ListFetch[cassandra] _seg__r0.nodes.deletions from _seg__r0 [elem:Commit]
            StoreQuery[neo4j] in=(c) out=(c, _seg__r0, a)
              : VarLengthExpand((c)-[_r0:PARENT*1..5]->(a:Commit)) emit _seg__r0
