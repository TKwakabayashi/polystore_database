                :   GetProperty(c.committed_date) [node:Commit]
                :     EntityScan(c:Commit)

## GIT4 — Deferred materialization (fetching only message after Top-k) at a small scale
traits: start=filtered scan hops=1 fan-out=low Top-10 | R1 start: c.insertions | R6 aggregate / sort: c.insertions, c.sha | R7 text: p.message

### GIT4 @graph
StoreQuery[neo4j] out=(c.sha, c.insertions, p.message)
  : Projection[c.sha, c.insertions, p.message]
  :   GetProperty(p.message) [node:Commit]
  :     Limit[10]
  :       Sort[c.insertions DESC, c.sha ASC]
  :         Projection[c.sha, c.insertions, p]
  :           GetProperty(c.sha) [node:Commit]
  :             Expand((c)-[_r0:PARENT]->(p:Commit))
  :               Filter((c.insertions >= 5000))
  :                 GetProperty(c.insertions) [node:Commit]
  :                   EntityScan(c:Commit)

### GIT4 @relational
Coord Projection[c.sha, c.insertions, p.message]
  Fetch[mysql] in=(p) out=(p, p.message)
    : GetProperty(p.message) [node:Commit]
    :   Argument(p)
    Coord Limit[10]
      Coord Sort[c.insertions DESC, c.sha ASC]
        Coord Projection[c.sha, c.insertions, p]
          Fetch[mysql] in=(c) out=(c, c.sha)
            : GetProperty(c.sha) [node:Commit]
            :   Argument(c)
            StoreQuery[neo4j] in=(c) out=(c, p)
              : Expand((c)-[_r0:PARENT]->(p:Commit))
              :   Argument(c)
              StoreQuery[mysql] out=(c, c.insertions)
                : Filter((c.insertions >= 5000))
                :   GetProperty(c.insertions) [node:Commit]
                :     EntityScan(c:Commit)

### GIT4 @document
Coord Projection[c.sha, c.insertions, p.message]
  Fetch[mongo] in=(p) out=(p, p.message)
    : GetProperty(p.message) [node:Commit]
    :   Argument(p)
    Coord Limit[10]
      Coord Sort[c.insertions DESC, c.sha ASC]
        Coord Projection[c.sha, c.insertions, p]
          Fetch[mongo] in=(c) out=(c, c.sha)
            : GetProperty(c.sha) [node:Commit]
            :   Argument(c)
            StoreQuery[neo4j] in=(c) out=(c, p)
              : Expand((c)-[_r0:PARENT]->(p:Commit))
              :   Argument(c)
              StoreQuery[mongo] out=(c, c.insertions)
                : Filter((c.insertions >= 5000))
                :   GetProperty(c.insertions) [node:Commit]
                :     EntityScan(c:Commit)

