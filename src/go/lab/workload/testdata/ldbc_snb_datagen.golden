  Coord Sort[replies DESC, root.comment_id ASC]
    Coord Aggregation[keys: root.comment_id | count(*) AS replies]
      StoreQuery[cassandra] in=(root) out=(root, root.comment_id)
        : GetProperty(root.comment_id) [node:Comment]
        :   Filter((root.length >= 50))
        :     GetProperty(root.length) [node:Comment]
        :       Argument(root)
        Coord Filter(all(x IN nodes(_seg__r0) WHERE (x.length >= 50)))
