Coord Projection[f.person_id, m.post_id, m.content]
  Fetch[cassandra] in=(m) out=(m, m.content)
    : GetProperty(m.content) [node:Post]
    :   Argument(m)
    Fetch[cassandra] in=(f) out=(f, f.person_id)
      : GetProperty(f.person_id) [node:Person]
      :   Argument(f)
      Coord Limit[20]
        Coord Sort[_sort0 DESC, m.post_id ASC]
          Coord Projection[m.post_id, m.creation_date AS _sort0, m, f]
            StoreQuery[cassandra] in=(m) out=(m, m.creation_date, m.post_id)
              : GetProperty(m.post_id) [node:Post]
              :   Filter((m.creation_date >= "2012-01-01"))
              :     GetProperty(m.creation_date) [node:Post]
              :       Argument(m)
              StoreQuery[cassandra] in=(f) out=(f)
                : Filter((f.browser = "Firefox"))
                :   GetProperty(f.browser) [node:Person]
                :     Argument(f)
                StoreQuery[neo4j] in=(p) out=(p, f, m)
                  : Expand((f)-[_r1:POSTED]->(m:Post))
                  :   Expand((p)-[_r0:KNOWS]-(f:Person))
                  :     Argument(p)
                  StoreQuery[cassandra] out=(p)
                    : Filter((p.first_name = "Jun"))
                    :   GetProperty(p.first_name) [node:Person]
                    :     EntityScan(p:Person)

### SNB1 @kvs
Coord Projection[f.person_id, m.post_id, m.content]
  Fetch[leveldb] in=(m) out=(m, m.content)
    : GetProperty(m.content) [node:Post]
    :   Argument(m)
    Fetch[leveldb] in=(f) out=(f, f.person_id)
      : GetProperty(f.person_id) [node:Person]
      :   Argument(f)
      Coord Limit[20]
