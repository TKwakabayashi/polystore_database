## SNB1 — A mixed query with start, middle and end conditions and a text output, run at several scales (sf1 to sf30)
traits: start=filtered scan hops=2 fan-out=medium Top-20 | R0 output: f.person_id | R1 start: p.first_name | R2 end: m.creation_date | R3 middle: f.browser | R6 aggregate / sort: m.creation_date, m.post_id | R7 text: m.content

### SNB1 @graph
StoreQuery[neo4j] out=(f.person_id, m.post_id, m.content)
  : Projection[f.person_id, m.post_id, m.content]
  :   GetProperty(m.content) [node:Post]
  :     GetProperty(f.person_id) [node:Person]
  :       Limit[20]
  :         Sort[_sort0 DESC, m.post_id ASC]
  :           Projection[m.post_id, m.creation_date AS _sort0, m, f]
  :             GetProperty(m.post_id) [node:Post]
  :               Filter((m.creation_date >= "2012-01-01"))
  :                 GetProperty(m.creation_date) [node:Post]
  :                   Expand((f)-[_r1:POSTED]->(m:Post))
  :                     Filter((f.browser = "Firefox"))
  :                       GetProperty(f.browser) [node:Person]
  :                         Expand((p)-[_r0:KNOWS]-(f:Person))
  :                           Filter((p.first_name = "Jun"))
  :                             GetProperty(p.first_name) [node:Person]
  :                               EntityScan(p:Person)

### SNB1 @relational
Coord Projection[f.person_id, m.post_id, m.content]
  Fetch[mysql] in=(m) out=(m, m.content)
    : GetProperty(m.content) [node:Post]
    :   Argument(m)
    Fetch[mysql] in=(f) out=(f, f.person_id)
      : GetProperty(f.person_id) [node:Person]
      :   Argument(f)
      Coord Limit[20]
        Coord Sort[_sort0 DESC, m.post_id ASC]
          Coord Projection[m.post_id, m.creation_date AS _sort0, m, f]
            StoreQuery[mysql] in=(m) out=(m, m.creation_date, m.post_id)
              : GetProperty(m.post_id) [node:Post]
              :   Filter((m.creation_date >= "2012-01-01"))
              :     GetProperty(m.creation_date) [node:Post]
              :       Argument(m)
              StoreQuery[mysql] in=(f) out=(f)
                : Filter((f.browser = "Firefox"))
                :   GetProperty(f.browser) [node:Person]
                :     Argument(f)
                StoreQuery[neo4j] in=(p) out=(p, f, m)
                  : Expand((f)-[_r1:POSTED]->(m:Post))
                  :   Expand((p)-[_r0:KNOWS]-(f:Person))
                  :     Argument(p)
                  StoreQuery[mysql] out=(p)
                    : Filter((p.first_name = "Jun"))
                    :   GetProperty(p.first_name) [node:Person]
                    :     EntityScan(p:Person)

### SNB1 @document
Coord Projection[f.person_id, m.post_id, m.content]
  Fetch[mongo] in=(m) out=(m, m.content)
    : GetProperty(m.content) [node:Post]
    :   Argument(m)
    Fetch[mongo] in=(f) out=(f, f.person_id)
      : GetProperty(f.person_id) [node:Person]
      :   Argument(f)
      Coord Limit[20]
        Coord Sort[_sort0 DESC, m.post_id ASC]
          Coord Projection[m.post_id, m.creation_date AS _sort0, m, f]
            StoreQuery[mongo] in=(m) out=(m, m.creation_date, m.post_id)
              : GetProperty(m.post_id) [node:Post]
              :   Filter((m.creation_date >= "2012-01-01"))
              :     GetProperty(m.creation_date) [node:Post]
              :       Argument(m)
              StoreQuery[mongo] in=(f) out=(f)
                : Filter((f.browser = "Firefox"))
                :   GetProperty(f.browser) [node:Person]
                :     Argument(f)
                StoreQuery[neo4j] in=(p) out=(p, f, m)
                  : Expand((f)-[_r1:POSTED]->(m:Post))
                  :   Expand((p)-[_r0:KNOWS]-(f:Person))
                  :     Argument(p)
                  StoreQuery[mongo] out=(p)
                    : Filter((p.first_name = "Jun"))
                    :   GetProperty(p.first_name) [node:Person]
                    :     EntityScan(p:Person)

### SNB1 @columnar
Coord Projection[f.person_id, m.post_id, m.content]
  Fetch[clickhouse] in=(m) out=(m, m.content)
    : GetProperty(m.content) [node:Post]
    :   Argument(m)
    Fetch[clickhouse] in=(f) out=(f, f.person_id)
      : GetProperty(f.person_id) [node:Person]
      :   Argument(f)
      Coord Limit[20]
        Coord Sort[_sort0 DESC, m.post_id ASC]
          Coord Projection[m.post_id, m.creation_date AS _sort0, m, f]
            StoreQuery[clickhouse] in=(m) out=(m, m.creation_date, m.post_id)
              : GetProperty(m.post_id) [node:Post]
              :   Filter((m.creation_date >= "2012-01-01"))
              :     GetProperty(m.creation_date) [node:Post]
              :       Argument(m)
              StoreQuery[clickhouse] in=(f) out=(f)
                : Filter((f.browser = "Firefox"))
                :   GetProperty(f.browser) [node:Person]
                :     Argument(f)
                StoreQuery[neo4j] in=(p) out=(p, f, m)
                  : Expand((f)-[_r1:POSTED]->(m:Post))
                  :   Expand((p)-[_r0:KNOWS]-(f:Person))
                  :     Argument(p)
                  StoreQuery[clickhouse] out=(p)
                    : Filter((p.first_name = "Jun"))
                    :   GetProperty(p.first_name) [node:Person]
                    :     EntityScan(p:Person)

