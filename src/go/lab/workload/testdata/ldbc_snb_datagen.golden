## SNB4 — Two hops through high-degree forum members: the trade-off of placing the middle condition, across scales
traits: start=filtered scan hops=2 fan-out=high aggregate Top-20 | R1 start: a.gender, a.birthday | R3 middle: fo.creation_date | R6 aggregate / sort: mod.person_id, a.person_id

### SNB4 @graph
StoreQuery[neo4j] out=(mod.person_id, members)
  : Limit[20]
  :   Sort[members DESC, mod.person_id ASC]
  :     Aggregation[keys: mod.person_id | count(DISTINCT a.person_id) AS members]
  :       GetProperty(a.person_id) [node:Person]
  :         GetProperty(mod.person_id) [node:Person]
  :           Expand((fo)<-[_r1:MODERATES]-(mod:Person))
  :             Filter((fo.creation_date >= "2012-06-01"))
  :               GetProperty(fo.creation_date) [node:Forum]
  :                 Expand((a)-[_r0:MEMBER_OF]->(fo:Forum))
  :                   Filter((a.birthday >= "1995-01-01"))
  :                     GetProperty(a.birthday) [node:Person]
  :                       Filter((a.gender = "female"))
  :                         GetProperty(a.gender) [node:Person]
  :                           EntityScan(a:Person)

### SNB4 @relational
Coord Limit[20]
  Coord Sort[members DESC, mod.person_id ASC]
    Coord Aggregation[keys: mod.person_id | count(DISTINCT a.person_id) AS members]
      Fetch[mysql] in=(a) out=(a, a.person_id)
        : GetProperty(a.person_id) [node:Person]
        :   Argument(a)
        Fetch[mysql] in=(mod) out=(mod, mod.person_id)
          : GetProperty(mod.person_id) [node:Person]
          :   Argument(mod)
          StoreQuery[mysql] in=(fo) out=(fo)
            : Filter((fo.creation_date >= "2012-06-01"))
            :   GetProperty(fo.creation_date) [node:Forum]
            :     Argument(fo)
            StoreQuery[neo4j] in=(a) out=(a, fo, mod)
              : Expand((fo)<-[_r1:MODERATES]-(mod:Person))
              :   Expand((a)-[_r0:MEMBER_OF]->(fo:Forum))
              :     Argument(a)
              StoreQuery[mysql] out=(a)
                : Filter((a.birthday >= "1995-01-01"))
                :   GetProperty(a.birthday) [node:Person]
                :     Filter((a.gender = "female"))
                :       GetProperty(a.gender) [node:Person]
                :         EntityScan(a:Person)

### SNB4 @document
Coord Limit[20]
  Coord Sort[members DESC, mod.person_id ASC]
    Coord Aggregation[keys: mod.person_id | count(DISTINCT a.person_id) AS members]
      Fetch[mongo] in=(a) out=(a, a.person_id)
        : GetProperty(a.person_id) [node:Person]
        :   Argument(a)
        Fetch[mongo] in=(mod) out=(mod, mod.person_id)
          : GetProperty(mod.person_id) [node:Person]
          :   Argument(mod)
          StoreQuery[mongo] in=(fo) out=(fo)
            : Filter((fo.creation_date >= "2012-06-01"))
            :   GetProperty(fo.creation_date) [node:Forum]
            :     Argument(fo)
            StoreQuery[neo4j] in=(a) out=(a, fo, mod)
              : Expand((fo)<-[_r1:MODERATES]-(mod:Person))
              :   Expand((a)-[_r0:MEMBER_OF]->(fo:Forum))
              :     Argument(a)
              StoreQuery[mongo] out=(a)
                : Filter((a.birthday >= "1995-01-01"))
                :   GetProperty(a.birthday) [node:Person]
                :     Filter((a.gender = "female"))
                :       GetProperty(a.gender) [node:Person]
                :         EntityScan(a:Person)

### SNB4 @columnar
Coord Limit[20]
  Coord Sort[members DESC, mod.person_id ASC]
    Coord Aggregation[keys: mod.person_id | count(DISTINCT a.person_id) AS members]
      Fetch[clickhouse] in=(a) out=(a, a.person_id)
        : GetProperty(a.person_id) [node:Person]
        :   Argument(a)
        Fetch[clickhouse] in=(mod) out=(mod, mod.person_id)
          : GetProperty(mod.person_id) [node:Person]
          :   Argument(mod)
          StoreQuery[clickhouse] in=(fo) out=(fo)
            : Filter((fo.creation_date >= "2012-06-01"))
            :   GetProperty(fo.creation_date) [node:Forum]
            :     Argument(fo)
            StoreQuery[neo4j] in=(a) out=(a, fo, mod)
              : Expand((fo)<-[_r1:MODERATES]-(mod:Person))
              :   Expand((a)-[_r0:MEMBER_OF]->(fo:Forum))
              :     Argument(a)
              StoreQuery[clickhouse] out=(a)
                : Filter((a.birthday >= "1995-01-01"))
                :   GetProperty(a.birthday) [node:Person]
                :     Filter((a.gender = "female"))
                :       GetProperty(a.gender) [node:Person]
                :         EntityScan(a:Person)

### SNB4 @widecolumn
Coord Limit[20]
  Coord Sort[members DESC, mod.person_id ASC]
    Coord Aggregation[keys: mod.person_id | count(DISTINCT a.person_id) AS members]
      Fetch[cassandra] in=(a) out=(a, a.person_id)
        : GetProperty(a.person_id) [node:Person]
        :   Argument(a)
        Fetch[cassandra] in=(mod) out=(mod, mod.person_id)
          : GetProperty(mod.person_id) [node:Person]
          :   Argument(mod)
          StoreQuery[cassandra] in=(fo) out=(fo)
            : Filter((fo.creation_date >= "2012-06-01"))
            :   GetProperty(fo.creation_date) [node:Forum]
            :     Argument(fo)
            StoreQuery[neo4j] in=(a) out=(a, fo, mod)
              : Expand((fo)<-[_r1:MODERATES]-(mod:Person))
              :   Expand((a)-[_r0:MEMBER_OF]->(fo:Forum))
              :     Argument(a)
              StoreQuery[cassandra] out=(a)
                : Filter((a.birthday >= "1995-01-01"))
                :   GetProperty(a.birthday) [node:Person]
                :     Filter((a.gender = "female"))
                :       GetProperty(a.gender) [node:Person]
                :         EntityScan(a:Person)

