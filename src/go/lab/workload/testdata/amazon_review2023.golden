              : RelUniqueFilter[r1, r2]
              :   Expand((u)-[r2:REVIEWED]->(j:Item))
              :     Expand((i)<-[r1:REVIEWED]-(u:User))
              :       Argument(i)
              StoreQuery[cassandra] out=(i)
                : Filter((i.rating_number >= 50000))
                :   GetProperty(i.rating_number) [node:Item]
                :     EntityScan(i:Item)

### AMZ2 @kvs
Coord Limit[20]
  Coord Sort[c DESC, j.parent_asin ASC]
    Coord Aggregation[keys: j.parent_asin | count(*) AS c]
      Fetch[leveldb] in=(j) out=(j, j.parent_asin)
        : GetProperty(j.parent_asin) [node:Item]
        :   Argument(j)
        StoreQuery[leveldb] in=(r2) out=(r2)
          : Filter((r2.rating >= 5))
          :   GetProperty(r2.rating) [rel:REVIEWED]
          :     Argument(r2)
          StoreQuery[leveldb] in=(r1) out=(r1)
            : Filter((r1.helpful_vote >= 10))
            :   GetProperty(r1.helpful_vote) [rel:REVIEWED]
            :     Argument(r1)
            StoreQuery[neo4j] in=(i) out=(i, j, r1, r2)
              : RelUniqueFilter[r1, r2]
              :   Expand((u)-[r2:REVIEWED]->(j:Item))
              :     Expand((i)<-[r1:REVIEWED]-(u:User))
              :       Argument(i)
              StoreQuery[leveldb] out=(i)
                : Filter((i.rating_number >= 50000))
                :   GetProperty(i.rating_number) [node:Item]
                :     EntityScan(i:Item)

## AMZ3 — Fetching review text on edges after Top-k (deferred materialization of edge properties)
traits: start=filtered scan hops=1 fan-out=medium Top-10 | R0 output: i.title | R1 start: i.average_rating | R5 edge: r.helpful_vote | R6 aggregate / sort: r.helpful_vote, i.title | R7 text: r.text, r.title

### AMZ3 @graph
StoreQuery[neo4j] out=(i.title, r.title, r.text)
  : Projection[i.title, r.title, r.text]
  :   GetProperty(r.text) [rel:REVIEWED]
  :     GetProperty(r.title) [rel:REVIEWED]
  :       Limit[10]
  :         Sort[_sort0 DESC, i.title ASC]
  :           Projection[i.title, r.helpful_vote AS _sort0, r]
  :             GetProperty(i.title) [node:Item]
  :               Filter((r.helpful_vote >= 100))
  :                 GetProperty(r.helpful_vote) [rel:REVIEWED]
  :                   Expand((i)<-[r:REVIEWED]-(u:User))
  :                     Filter((i.average_rating <= 2))
  :                       GetProperty(i.average_rating) [node:Item]
  :                         EntityScan(i:Item)

### AMZ3 @relational
Coord Projection[i.title, r.title, r.text]
  Fetch[mysql] in=(r) out=(r, r.text, r.title)
    : GetProperty(r.text) [rel:REVIEWED]
    :   GetProperty(r.title) [rel:REVIEWED]
    :     Argument(r)
    Coord Limit[10]
      Coord Sort[_sort0 DESC, i.title ASC]
        Coord Projection[i.title, r.helpful_vote AS _sort0, r]
          Fetch[mysql] in=(i) out=(i, i.title)
            : GetProperty(i.title) [node:Item]
            :   Argument(i)
            StoreQuery[mysql] in=(r) out=(r, r.helpful_vote)
              : Filter((r.helpful_vote >= 100))
              :   GetProperty(r.helpful_vote) [rel:REVIEWED]
              :     Argument(r)
              StoreQuery[neo4j] in=(i) out=(i, r)
                : Expand((i)<-[r:REVIEWED]-(u:User))
                :   Argument(i)
                StoreQuery[mysql] out=(i)
                  : Filter((i.average_rating <= 2))
                  :   GetProperty(i.average_rating) [node:Item]
                  :     EntityScan(i:Item)

### AMZ3 @document
Coord Projection[i.title, r.title, r.text]
  Fetch[mongo] in=(r) out=(r, r.text, r.title)
    : GetProperty(r.text) [rel:REVIEWED]
    :   GetProperty(r.title) [rel:REVIEWED]
    :     Argument(r)
    Coord Limit[10]
