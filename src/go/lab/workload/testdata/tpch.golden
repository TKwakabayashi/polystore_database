## TPCH3 — Four hops from one unique-key start: with a small start, boundaries cost round trips
traits: start=unique key hops=4 fan-out=low aggregate | R1 start: c.custkey | R3 middle: l.returnflag | R6 aggregate / sort: n.name, s.suppkey, l.quantity

### TPCH3 @graph
StoreQuery[neo4j] out=(n.name, suppliers, qty)
  : Sort[qty DESC, n.name ASC]
  :   Aggregation[keys: n.name | count(DISTINCT s.suppkey) AS suppliers, sum(l.quantity) AS qty]
  :     GetProperty(l.quantity) [node:Lineitem]
  :       GetProperty(s.suppkey) [node:Supplier]
  :         GetProperty(n.name) [node:Nation]
  :           Expand((s)-[_r3:SUPP_IN]->(n:Nation))
  :             Expand((l)-[_r2:SUPPLIED_BY]->(s:Supplier))
  :               Filter((l.returnflag = "N"))
  :                 GetProperty(l.returnflag) [node:Lineitem]
  :                   Expand((o)-[_r1:CONTAINS]->(l:Lineitem))
  :                     Expand((c)-[_r0:PLACED]->(o:Order))
  :                       Filter((c.custkey = "1"))
  :                         GetProperty(c.custkey) [node:Customer]
  :                           EntityScan(c:Customer)

### TPCH3 @relational
Coord Sort[qty DESC, n.name ASC]
  Coord Aggregation[keys: n.name | count(DISTINCT s.suppkey) AS suppliers, sum(l.quantity) AS qty]
    Fetch[mysql] in=(l) out=(l, l.quantity)
      : GetProperty(l.quantity) [node:Lineitem]
      :   Argument(l)
      Fetch[mysql] in=(s) out=(s, s.suppkey)
        : GetProperty(s.suppkey) [node:Supplier]
        :   Argument(s)
        Fetch[mysql] in=(n) out=(n, n.name)
          : GetProperty(n.name) [node:Nation]
          :   Argument(n)
          StoreQuery[mysql] in=(l) out=(l)
            : Filter((l.returnflag = "N"))
            :   GetProperty(l.returnflag) [node:Lineitem]
            :     Argument(l)
            StoreQuery[neo4j] in=(c) out=(c, l, n, s)
              : Expand((s)-[_r3:SUPP_IN]->(n:Nation))
              :   Expand((l)-[_r2:SUPPLIED_BY]->(s:Supplier))
              :     Expand((o)-[_r1:CONTAINS]->(l:Lineitem))
              :       Expand((c)-[_r0:PLACED]->(o:Order))
              :         Argument(c)
              StoreQuery[mysql] out=(c)
                : Filter((c.custkey = "1"))
                :   GetProperty(c.custkey) [node:Customer]
                :     EntityScan(c:Customer)

### TPCH3 @document
Coord Sort[qty DESC, n.name ASC]
  Coord Aggregation[keys: n.name | count(DISTINCT s.suppkey) AS suppliers, sum(l.quantity) AS qty]
    Fetch[mongo] in=(l) out=(l, l.quantity)
      : GetProperty(l.quantity) [node:Lineitem]
      :   Argument(l)
      Fetch[mongo] in=(s) out=(s, s.suppkey)
        : GetProperty(s.suppkey) [node:Supplier]
        :   Argument(s)
        Fetch[mongo] in=(n) out=(n, n.name)
