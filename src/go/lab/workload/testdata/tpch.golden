## TPCH1 — A fixed two-hop analysis with a condition per hop: how the number of boundaries changes with which hop is relational
traits: start=filtered scan hops=2 fan-out=medium aggregate Top-10 | R1 start: c.mktsegment | R2 end: l.shipdate | R3 middle: o.orderdate | R6 aggregate / sort: o.orderkey, o.orderdate, l.extendedprice

### TPCH1 @graph
StoreQuery[neo4j] out=(o.orderkey, o.orderdate, revenue)
  : Limit[10]
  :   Sort[revenue DESC, o.orderkey ASC]
  :     Aggregation[keys: o.orderkey, o.orderdate | sum(l.extendedprice) AS revenue]
  :       GetProperty(l.extendedprice) [node:Lineitem]
  :         GetProperty(o.orderkey) [node:Order]
  :           Filter((l.shipdate > "1995-03-15"))
  :             GetProperty(l.shipdate) [node:Lineitem]
  :               Expand((o)-[_r1:CONTAINS]->(l:Lineitem))
  :                 Filter((o.orderdate < "1995-03-15"))
  :                   GetProperty(o.orderdate) [node:Order]
  :                     Expand((c)-[_r0:PLACED]->(o:Order))
  :                       Filter((c.mktsegment = "BUILDING"))
  :                         GetProperty(c.mktsegment) [node:Customer]
  :                           EntityScan(c:Customer)

### TPCH1 @relational
Coord Limit[10]
  Coord Sort[revenue DESC, o.orderkey ASC]
    Coord Aggregation[keys: o.orderkey, o.orderdate | sum(l.extendedprice) AS revenue]
      Fetch[mysql] in=(l) out=(l, l.extendedprice)
        : GetProperty(l.extendedprice) [node:Lineitem]
        :   Argument(l)
        Fetch[mysql] in=(o) out=(o, o.orderkey)
          : GetProperty(o.orderkey) [node:Order]
          :   Argument(o)
          StoreQuery[mysql] in=(l) out=(l)
            : Filter((l.shipdate > "1995-03-15"))
            :   GetProperty(l.shipdate) [node:Lineitem]
            :     Argument(l)
            StoreQuery[mysql] in=(o) out=(o, o.orderdate)
              : Filter((o.orderdate < "1995-03-15"))
              :   GetProperty(o.orderdate) [node:Order]
              :     Argument(o)
              StoreQuery[neo4j] in=(c) out=(c, l, o)
                : Expand((o)-[_r1:CONTAINS]->(l:Lineitem))
                :   Expand((c)-[_r0:PLACED]->(o:Order))
                :     Argument(c)
                StoreQuery[mysql] out=(c)
                  : Filter((c.mktsegment = "BUILDING"))
                  :   GetProperty(c.mktsegment) [node:Customer]
                  :     EntityScan(c:Customer)

### TPCH1 @document
Coord Limit[10]
  Coord Sort[revenue DESC, o.orderkey ASC]
    Coord Aggregation[keys: o.orderkey, o.orderdate | sum(l.extendedprice) AS revenue]
      Fetch[mongo] in=(l) out=(l, l.extendedprice)
        : GetProperty(l.extendedprice) [node:Lineitem]
        :   Argument(l)
        Fetch[mongo] in=(o) out=(o, o.orderkey)
          : GetProperty(o.orderkey) [node:Order]
          :   Argument(o)
          StoreQuery[mongo] in=(l) out=(l)
            : Filter((l.shipdate > "1995-03-15"))
            :   GetProperty(l.shipdate) [node:Lineitem]
            :     Argument(l)
            StoreQuery[mongo] in=(o) out=(o, o.orderdate)
              : Filter((o.orderdate < "1995-03-15"))
              :   GetProperty(o.orderdate) [node:Order]
              :     Argument(o)
              StoreQuery[neo4j] in=(c) out=(c, l, o)
                : Expand((o)-[_r1:CONTAINS]->(l:Lineitem))
                :   Expand((c)-[_r0:PLACED]->(o:Order))
                :     Argument(c)
                StoreQuery[mongo] out=(c)
                  : Filter((c.mktsegment = "BUILDING"))
                  :   GetProperty(c.mktsegment) [node:Customer]
                  :     EntityScan(c:Customer)

