          :     Expand((o)-[_r2:CONTAINS]->(l:Lineitem))
          :       Expand((c)-[_r1:PLACED]->(o:Order))
          :         Expand((cn)<-[_r0:CUST_IN]-(c:Customer))
          :           Argument(cn)
          StoreQuery[mysql] out=(cn)
            : Filter((cn.name = "GERMANY"))
