## WIKI2 — Fetching full text (17.5GB in total) after Top-k, and the effect of a smaller graph, at their strongest
traits: start=filtered scan hops=2 fan-out=high Top-10 | R0 output: p.title, c.name | R1 start: p.namespace | R3 middle: r.timestamp | R6 aggregate / sort: r.text_bytes, r.rev_id | R7 text: r.text

### WIKI2 @graph
StoreQuery[neo4j] out=(p.title, c.name, r.text)
  : Projection[p.title, c.name, r.text]
  :   GetProperty(r.text) [node:Revision]
  :     GetProperty(c.name) [node:Contributor]
  :       GetProperty(p.title) [node:Page]
  :         Limit[10]
  :           Sort[_sort0 DESC, _sort1 ASC]
  :             Projection[r.text_bytes AS _sort0, r.rev_id AS _sort1, r, c, p]
  :               GetProperty(r.rev_id) [node:Revision]
  :                 GetProperty(r.text_bytes) [node:Revision]
  :                   Expand((r)<-[_r1:EDITED]-(c:Contributor))
  :                     Filter((r.timestamp >= "2023-01-01"))
  :                       GetProperty(r.timestamp) [node:Revision]
  :                         Expand((p)-[_r0:HAS_REVISION]->(r:Revision))
  :                           Filter((p.namespace = 0))
  :                             GetProperty(p.namespace) [node:Page]
  :                               EntityScan(p:Page)

### WIKI2 @relational
Coord Projection[p.title, c.name, r.text]
  Fetch[mysql] in=(r) out=(r, r.text)
    : GetProperty(r.text) [node:Revision]
    :   Argument(r)
    Fetch[mysql] in=(c) out=(c, c.name)
      : GetProperty(c.name) [node:Contributor]
      :   Argument(c)
      Fetch[mysql] in=(p) out=(p, p.title)
        : GetProperty(p.title) [node:Page]
        :   Argument(p)
        Coord Limit[10]
          Coord Sort[_sort0 DESC, _sort1 ASC]
            Coord Projection[r.text_bytes AS _sort0, r.rev_id AS _sort1, r, c, p]
              StoreQuery[mysql] in=(r) out=(r, r.rev_id, r.text_bytes)
                : GetProperty(r.rev_id) [node:Revision]
                :   GetProperty(r.text_bytes) [node:Revision]
                :     Filter((r.timestamp >= "2023-01-01"))
                :       GetProperty(r.timestamp) [node:Revision]
                :         Argument(r)
                StoreQuery[neo4j] in=(p) out=(p, c, r)
                  : Expand((r)<-[_r1:EDITED]-(c:Contributor))
                  :   Expand((p)-[_r0:HAS_REVISION]->(r:Revision))
                  :     Argument(p)
                  StoreQuery[mysql] out=(p)
                    : Filter((p.namespace = 0))
                    :   GetProperty(p.namespace) [node:Page]
                    :     EntityScan(p:Page)

### WIKI2 @document
Coord Projection[p.title, c.name, r.text]
  Fetch[mongo] in=(r) out=(r, r.text)
    : GetProperty(r.text) [node:Revision]
    :   Argument(r)
    Fetch[mongo] in=(c) out=(c, c.name)
      : GetProperty(c.name) [node:Contributor]
      :   Argument(c)
      Fetch[mongo] in=(p) out=(p, p.title)
