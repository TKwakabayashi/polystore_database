            StoreQuery[cassandra] out=(r)
              : Filter((r.text_bytes >= 500000))
              :   GetProperty(r.text_bytes) [node:Revision]
              :     EntityScan(r:Revision)

### WIKI4 @kvs
Coord Limit[20]
  Coord Sort[edits DESC, d.name ASC]
    Coord Aggregation[keys: d.name | count(*) AS edits]
      Fetch[leveldb] in=(d) out=(d, d.name)
        : GetProperty(d.name) [node:Contributor]
        :   Argument(d)
        StoreQuery[leveldb] in=(o) out=(o)
          : Filter((o.timestamp >= "2020-01-01"))
          :   GetProperty(o.timestamp) [node:Revision]
          :     Argument(o)
          StoreQuery[neo4j] in=(r) out=(r, d, o) weighted
            : Expand((o)<-[_r1:EDITED]-(d:Contributor))
            :   VarLengthExpand((r)-[_r0:PREV*1..3]->(o:Revision))
            :     Argument(r)
            StoreQuery[leveldb] out=(r)
              : Filter((r.text_bytes >= 500000))
              :   GetProperty(r.text_bytes) [node:Revision]
              :     EntityScan(r:Revision)

