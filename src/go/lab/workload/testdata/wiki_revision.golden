        :     GetProperty(o.text_bytes) [node:Revision]
        :       Argument(o)
        Coord Filter(all(x IN nodes(_seg__r0) WHERE (x.text_bytes >= 100000)))
          ListFetch[mongo] _seg__r0.nodes.text_bytes from _seg__r0 [elem:Revision]
            StoreQuery[neo4j] in=(r) out=(r, _seg__r0, o)
              : VarLengthExpand((r)-[_r0:PREV*1..10]->(o:Revision)) emit _seg__r0
              :   Argument(r)
              StoreQuery[mongo] out=(r)
                : Filter((r.text_bytes >= 100000))
                :   Filter((r.text_bytes >= 500000))
                :     GetProperty(r.text_bytes) [node:Revision]
                :       EntityScan(r:Revision)

